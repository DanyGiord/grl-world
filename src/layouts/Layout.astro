---
interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "GRL WORLD — Creative swimwear, beach outfits and summer style. DM to order.",
  image = "/img/shop/p5.jpg",
  url = "https://grlworld.com",
  type = "website",
} = Astro.props;

const siteName = "GRL WORLD";
const canonicalURL = Astro.url ? Astro.url.href : url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="swimwear, bikini, beach outfits, summer style, gym set, stripe set, grl world, gr1world" />
    <meta name="author" content="GRL WORLD" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@gr1world" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fcd8da" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ClothingStore",
      "name": "GRL WORLD",
      "alternateName": "GR1WORLD",
      "url": "https://grlworld.com",
      "logo": "https://grlworld.com/favicon.svg",
      "image": `https://grlworld.com${image}`,
      "description": description,
      "sameAs": ["https://www.instagram.com/gr1world"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": "https://www.instagram.com/gr1world"
      }
    })} />
  </head>

  <body>
    <slot />
    <script>
      import gsap from "gsap";
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background: #fcd8da;
    overflow-x: hidden;
  }
  body { overflow-x: hidden; }
  code {
    font-family:
      "TAN-NIMBUS",
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  @font-face {
    font-family: "TAN-NIMBUS";
    src: url("/fonts/TAN-NIMBUS.woff") format("woff");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
