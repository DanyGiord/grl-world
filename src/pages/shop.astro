    function closePanel() {
      gsap.to(orderPanel, { x: "-100%", duration: 0.35, ease: "power3.in", onComplete: () => gsap.set(orderPanel, { display: "none" }) });
      gsap.to(orderBackdrop, { autoAlpha: 0, duration: 0.3, onComplete: () => gsap.set(orderBackdrop, { display: "none" }) });
      document.body.style.overflow = "";
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
