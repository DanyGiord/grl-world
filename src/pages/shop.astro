            <p style="font-family:'TAN-NIMBUS',sans-serif;color:rgba(255,255,255,0.85);font-size:0.85rem;letter-spacing:0.18em;line-height:1.9;margin:0;">
              NO ITEMS ADDED YET.<br>CLICK
            </p>
            <img src="/img/collage/slay.png" alt="SLAY" style="width:80px;filter:drop-shadow(0 2px 8px rgba(0,0,0,0.4));transform:rotate(8deg);" />
            <p style="font-family:'TAN-NIMBUS',sans-serif;color:rgba(255,255,255,0.85);font-size:0.85rem;letter-spacing:0.18em;line-height:1.9;margin:0;">
              ON ANY LOOK TO ADD IT.
            </p>
          </div>`;
