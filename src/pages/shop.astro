  /* ─── CATEGORY FILTER ─── */
  {
    const catBtns = document.querySelectorAll<HTMLButtonElement>(".cat-btn");

    // Build groups: each group-label + all siblings until next group-label
    type CatGroup = { cat: string; els: HTMLElement[]; hideTimer?: gsap.core.Tween };
    const groups: CatGroup[] = [];
    document.querySelectorAll<HTMLElement>(".group-label[data-cat-section]").forEach(label => {
      const cat = label.dataset.catSection!;
      const els: HTMLElement[] = [label];
      let el = label.nextElementSibling as HTMLElement | null;
      while (el && !el.classList.contains("group-label")) {
        els.push(el);
        el = el.nextElementSibling as HTMLElement | null;
      }
      groups.push({ cat, els });
    });

    function reveal(g: CatGroup, delay = 0) {
      if (g.hideTimer) { g.hideTimer.kill(); g.hideTimer = undefined; }
      gsap.killTweensOf(g.els);
      // Kill & resolve all child tweens (cards, label text, etc.)
      g.els.forEach(el => {
        const inner = el.querySelectorAll<HTMLElement>(".card, .group-num, .group-name, .group-price, .size-guide-btn, .lookbook-label, .lookbook-title, .lookbook-sub");
        if (inner.length) {
          gsap.killTweensOf(inner);
          gsap.set(inner, { opacity: 1, x: 0, y: 0, visibility: "visible" });
        }
        if (el.classList.contains("group-label")) gsap.set(el, { scaleX: 1 });
      });
      gsap.set(g.els, { display: "", opacity: 0, y: 36, visibility: "visible" });
      gsap.to(g.els, { opacity: 1, y: 0, duration: 0.55, ease: "power3.out", stagger: 0.05, delay });
    }

    function hide(g: CatGroup) {
      if (g.hideTimer) g.hideTimer.kill();
      gsap.killTweensOf(g.els);
      const totalDur = 0.3 + 0.025 * g.els.length + 0.1;
      gsap.to(g.els, { opacity: 0, y: -16, duration: 0.28, ease: "power2.in", stagger: 0.025 });
      g.hideTimer = gsap.delayedCall(totalDur, () => { gsap.set(g.els, { display: "none" }); g.hideTimer = undefined; });
    }

    function scrollToCollection() {
      const col = document.getElementById("collection");
      if (col) window.scrollTo({ top: col.getBoundingClientRect().top + window.scrollY - 80, behavior: "smooth" });
    }

    function showAll() {
      scrollToCollection();
      groups.forEach(g => reveal(g));
    }

    function showCat(cat: string) {
      scrollToCollection();
      groups.forEach(g => {
        if (g.cat === cat) reveal(g, 0.25);
        else hide(g);
      });
    }

    catBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        catBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const cat = btn.dataset.cat!;
        if (cat === "all") { showAll(); } else { showCat(cat); }
      });
    });
  }

