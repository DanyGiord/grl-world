    const sizeBtns = document.querySelectorAll<HTMLButtonElement>(".size-btn");

    let pendingCallback: ((size?: string) => void) | null = null;

    function showSizeModal(onSelect: (size?: string) => void) {
      pendingCallback = onSelect;
      sizeModal.style.display = "flex";
      gsap.fromTo(sizeModalInner,
        { scale: 0.8, autoAlpha: 0 },
        { scale: 1, autoAlpha: 1, duration: 0.35, ease: "back.out(2)" }
      );
    }

    function hideSizeModal() {
      gsap.to(sizeModalInner, {
        scale: 0.88, autoAlpha: 0, duration: 0.22, ease: "power2.in",
        onComplete: () => { sizeModal.style.display = "none"; }
      });
      pendingCallback = null;
    }

    sizeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const size = btn.dataset.size!;
        const cb = pendingCallback;
        hideSizeModal();
        cb?.(size);
      });
    });

    sizeModalCancel.addEventListener("click", hideSizeModal);
    sizeModal.addEventListener("click", (e) => { if (e.target === sizeModal) hideSizeModal(); });

