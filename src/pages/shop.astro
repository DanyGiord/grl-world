---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SHOP — GRL WORLD" />

<div id="entry-curtain"></div>

<div class="stk-layer" aria-hidden="true"></div>
<img id="gummy-btn" src="/img/collage/gummy-bear.png" />

<main>

  <!-- ── HERO ── -->
  <section class="hero">
    <video class="hero-video" src="/video/hero.mp4" autoplay muted loop playsinline></video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="word">GRL</span>
        <span class="word">WORLD</span>
      </h1>
      <p class="hero-sub">COLLECTION</p>
    </div>
    <a href="/" class="back-link">← BACK</a>
    <a href="#collection" class="scroll-hint">SCROLL ↓</a>
  </section>

  <!-- ── MARQUEE ── -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      {Array.from({ length: 8 }, () => (
        <span class="marquee-item">GRL WORLD &nbsp;·&nbsp; BIKINIS &nbsp;·&nbsp; GYM SET &nbsp;·&nbsp; STRIPE SET &nbsp;·&nbsp; DM TO ORDER &nbsp;·&nbsp;</span>
      ))}
    </div>
  </div>

  <!-- ── COLLECTION ── -->
  <section class="collection" id="collection">

    <!-- ══ BIKINIS ══ -->
    <div class="group-label">
      <span class="group-num">01</span>
      <span class="group-name">BIKINIS</span>
    </div>

    <div class="editorial-row">
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p5.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p26.jpg" alt="" loading="lazy" style="object-position: center 100%; transform: translateY(30%);" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p27.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <div class="grid-3">
      {[7,8,9,10,12,19].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/p${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <div class="pair">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p24.jpg" alt="" loading="lazy" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p25.jpg" alt="" loading="lazy" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <div class="grid-2">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p28.jpg" alt="" loading="lazy" style="object-position: center top;" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p31.jpg" alt="" loading="lazy" style="object-position: center top;" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <!-- ══ GYM SET ══ -->
    <div class="group-label">
      <span class="group-num">02</span>
      <span class="group-name">GYM SET</span>
    </div>

    <div class="editorial-row editorial-row--reverse">
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p15.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p16.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p14.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <!-- BLACK row -->
    <div class="grid-4">
      {["p4","p34","gym1","gym2"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- BLACK → GREY pair -->
    <div class="pair">
      {["p1","p6"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- GREY → BLUE row -->
    <div class="grid-3">
      {["p23","p30","p18"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- WHITE / LIGHT pair -->
    <div class="pair">
      {["p3","p2"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- GYM VIDEO VERTICAL + WIDE VIDEO -->
    <div class="gym-videos">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card card-vertical">
        <video src="/video/gymvideo.mp4" autoplay muted loop playsinline></video>
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card card-video-side">
        <video src="/video/v2.mp4" autoplay muted loop playsinline></video>
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <!-- ══ STRIPE SET ══ -->
    <div class="group-label">
      <span class="group-num">03</span>
      <span class="group-name">STRIPE SET</span>
    </div>

    <div class="editorial-row">
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p20.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p21.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p22.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <div class="grid-3">
      {[11,13,17,29,33,32].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/p${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>


  </section>

  <!-- ── MISSION ── -->
  <section class="mission">
    <div class="mission-inner">
      <div class="mission-top-line"></div>
      <div class="mission-layout">
        <div class="mission-left">
          <h2 class="mission-title">OUR<br>MISSION</h2>
        </div>
        <div class="mission-right">
          <p class="mission-body">GR1WORLD IS COMING SOON, LIKE A RAY OF SUNSHINE ON THE SHORE, BRINGING CREATIVE SWIMWEAR AND SUMMER OUTFITS FOR THE BEACH. EXPECT MAGICAL BIKINI COMBINATIONS THAT WILL HELP YOU SHINE LIKE SEA FOAM. GET READY TO EMBARK ON A JOURNEY WHERE BEAUTY DANCES WITH THE WAVES AND STYLE WHISPERS IN THE SEA BREEZE, AS GR1WORLD UNVEILS ITS ENCHANTING CREATIONS FOR YOU TO EMBRACE UNDER THE SUN'S GOLDEN GAZE.</p>
        </div>
      </div>
    </div>

    <!-- CTA inside mission block -->
    <div class="cta-block">
      <div class="cta-divider"></div>
      <p class="cta-label">FOR ORDERS & ENQUIRIES</p>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="cta-btn">
        @GR1WORLD
      </a>
    </div>
  </section>


</main>

<!-- ── MOBILE LIGHTBOX ── -->
<div id="lb-overlay">
  <button id="lb-close">✕</button>
  <p id="lb-cat"></p>
  <img id="lb-img" src="" alt="" />
  <button id="lb-prev">‹</button>
  <button id="lb-next">›</button>
  <p id="lb-counter"></p>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const entryCurtain = document.getElementById("entry-curtain")!;
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {

    /* ─── GUMMY BEAR SCROLL-TO-TOP ─── */
    const gummy = document.getElementById("gummy-btn") as HTMLElement | null;
    if (gummy) {
      // float animation
      gsap.to(gummy, { y: -10, duration: 2.9, repeat: -1, yoyo: true, ease: "sine.inOut" });

      // show after scrolling past hero
      ScrollTrigger.create({
        trigger: ".hero",
        start: "bottom 80%",
        onEnter: () => gsap.to(gummy, { autoAlpha: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }),
        onLeaveBack: () => gsap.to(gummy, { autoAlpha: 0, scale: 0.5, duration: 0.3 }),
      });

      gummy.addEventListener("click", () => {
        gsap.to(gummy, { rotation: -16 + 360, duration: 0.6, ease: "power2.inOut", onComplete: () => gsap.set(gummy, { rotation: -16 }) });
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    /* ─── ENTRY CURTAIN ─── */
    gsap.to(entryCurtain, {
      scaleY: 0,
      duration: 0.7,
      ease: "power3.inOut",
      onComplete: () => entryCurtain.remove(),
    });

    /* ─── HERO ─── */
    gsap.from(".word", {
      y: 80, autoAlpha: 0, duration: 1.3, ease: "power3.out",
      stagger: 0.15, delay: 0.4,
    });
    gsap.from(".hero-sub",    { y: 30,  autoAlpha: 0, duration: 0.9, ease: "power2.out", delay: 0.85 });
    gsap.from(".back-link",   { x: -20, autoAlpha: 0, duration: 0.7, ease: "power2.out", delay: 0.5 });
    gsap.from(".scroll-hint", { autoAlpha: 0, duration: 0.7, delay: 1.2 });

    /* ─── HERO PARALLAX ─── */
    gsap.to(".hero-video", {
      scale: 1.12, ease: "none",
      scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
    });

    gsap.to(".scroll-hint", {
      autoAlpha: 0,
      scrollTrigger: { trigger: ".hero", start: "20% top", end: "40% top", scrub: true },
    });

    /* ─── MARQUEE ─── */
    gsap.from(".marquee-wrap", {
      autoAlpha: 0, duration: 0.8,
      scrollTrigger: { trigger: ".marquee-wrap", start: "top 92%" },
    });

    /* ─── GROUP LABELS ─── */
    document.querySelectorAll(".group-label").forEach((label) => {
      const num  = label.querySelector(".group-num");
      const name = label.querySelector(".group-name");
      const st   = { trigger: label, start: "top 88%" };
      gsap.from(label, { scaleX: 0, transformOrigin: "left", duration: 0.9, ease: "power3.out", scrollTrigger: st });
      gsap.from(num,   { x: -50, autoAlpha: 0, duration: 0.9, ease: "power3.out", delay: 0.15, scrollTrigger: st });
      gsap.from(name,  { x: 30,  autoAlpha: 0, duration: 0.7, ease: "power2.out", delay: 0.3,  scrollTrigger: st });
    });

    /* ─── CARDS: CLIP REVEAL + IMAGE PARALLAX ─── */
    document.querySelectorAll(".card").forEach((card) => {
      gsap.from(card, {
        clipPath: "inset(100% 0 0 0)",
        duration: 1.1, ease: "power4.out",
        scrollTrigger: { trigger: card, start: "top 90%" },
      });

      const media = card.querySelector("img, video");
      if (media) {
        gsap.fromTo(media, { y: "-8%" }, {
          y: "8%", ease: "none",
          scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: true },
        });
      }
    });

    /* ─── MISSION + CTA ─── */
    gsap.from(".mission-top-line", {
      scaleX: 0, transformOrigin: "left", duration: 1.2, ease: "power3.out",
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".mission-title", {
      autoAlpha: 0, duration: 1, ease: "power2.out", delay: 0.2,
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".mission-body", {
      y: 35, autoAlpha: 0, duration: 1.1, ease: "power2.out", delay: 0.4,
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".cta-divider", {
      scaleX: 0, transformOrigin: "left", duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });
    gsap.from(".cta-label", {
      y: 20, autoAlpha: 0, duration: 0.8, delay: 0.2,
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });
    gsap.from(".cta-btn", {
      y: 20, autoAlpha: 0, duration: 0.7, delay: 0.4,
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });

    /* ─── BACK LINK EXIT ─── */
    const backLink = document.querySelector(".back-link") as HTMLAnchorElement | null;
    if (backLink) {
      backLink.addEventListener("click", (e) => {
        e.preventDefault();
        const href = backLink.getAttribute("href") || "/";
        const curtain = document.createElement("div");
        curtain.style.cssText = "position:fixed;inset:0;background:#f6aad9;z-index:9999;transform-origin:bottom;will-change:transform;";
        gsap.set(curtain, { scaleY: 0 });
        document.body.appendChild(curtain);
        gsap.to(".word, .hero-sub", { y: -40, autoAlpha: 0, duration: 0.3, stagger: 0.06, ease: "power2.in" });
        gsap.to(curtain, {
          scaleY: 1, duration: 0.65, ease: "power3.inOut",
          onComplete: () => { window.location.href = href; },
        });
      });
    }
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    entryCurtain.remove();
    document.querySelectorAll(".card").forEach(c => {
      (c as HTMLElement).style.clipPath = "none";
    });
  });

  /* ── MOBILE LIGHTBOX ── */
  (function () {
    if (window.innerWidth > 768) return;

    const overlay   = document.getElementById("lb-overlay")!;
    const lbImg     = document.getElementById("lb-img") as HTMLImageElement;
    const lbCat     = document.getElementById("lb-cat")!;
    const lbCounter = document.getElementById("lb-counter")!;
    const btnClose  = document.getElementById("lb-close")!;
    const btnPrev   = document.getElementById("lb-prev")!;
    const btnNext   = document.getElementById("lb-next")!;

    // Build groups per category
    type Group = { name: string; imgs: HTMLImageElement[] };
    const groups: Group[] = [];
    const imgToGroup = new Map<HTMLImageElement, { group: Group; idx: number }>();

    document.querySelectorAll<HTMLElement>(".group-label").forEach((label) => {
      const name = label.querySelector(".group-name")?.textContent?.trim() || "";
      const imgs: HTMLImageElement[] = [];
      let el = label.nextElementSibling;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLImageElement>(".card img").forEach(img => imgs.push(img));
        el = el.nextElementSibling;
      }
      const group: Group = { name, imgs };
      groups.push(group);
      imgs.forEach((img, idx) => imgToGroup.set(img, { group, idx }));
    });

    let currentGroup: Group = groups[0];
    let currentIdx = 0;

    function updateUI() {
      lbImg.src = currentGroup.imgs[currentIdx].src;
      lbCat.textContent = currentGroup.name;
      lbCounter.textContent = `${currentIdx + 1} / ${currentGroup.imgs.length}`;
    }

    function open(img: HTMLImageElement) {
      const info = imgToGroup.get(img);
      if (!info) return;
      currentGroup = info.group;
      currentIdx = info.idx;
      updateUI();
      gsap.set(overlay, { display: "flex" });
      gsap.fromTo(overlay, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3, ease: "power2.out" });
      document.body.style.overflow = "hidden";
    }

    function close() {
      gsap.to(overlay, { autoAlpha: 0, duration: 0.25, onComplete: () => gsap.set(overlay, { display: "none" }) });
      document.body.style.overflow = "";
    }

    function navigate(delta: number) {
      const dir = delta > 0 ? 40 : -40;
      currentIdx = (currentIdx + delta + currentGroup.imgs.length) % currentGroup.imgs.length;
      gsap.fromTo(lbImg, { autoAlpha: 0, x: dir }, { autoAlpha: 1, x: 0, duration: 0.25, ease: "power2.out" });
      updateUI();
    }

    // Wire up cards
    imgToGroup.forEach((_info, img) => {
      const card = img.closest("a");
      if (!card) return;
      card.addEventListener("click", (e) => { e.preventDefault(); open(img); });
    });

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => navigate(-1));
    btnNext.addEventListener("click", () => navigate(1));

    let startX = 0;
    overlay.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) navigate(dx < 0 ? 1 : -1);
    });
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
  })();
</script>

<style>
  main {
    margin: 0;
    padding: 0;
    background: #fcd8da;
  }

  /* ── MOBILE LIGHTBOX ── */
  #lb-overlay {
    display: none;
    position: fixed; inset: 0; z-index: 9000;
    background: rgba(0,0,0,0.92);
    align-items: center; justify-content: center;
    visibility: hidden; opacity: 0;
  }
  #lb-cat {
    position: absolute; top: 4rem; left: 50%; transform: translateX(-50%);
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: 1.1rem; letter-spacing: 0.2em;
    color: #f6aad9; margin: 0; white-space: nowrap;
  }
  #lb-counter {
    position: absolute; bottom: 5rem; left: 50%; transform: translateX(-50%);
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: 0.9rem; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.7); margin: 0;
    white-space: nowrap;
  }
  #lb-img {
    max-width: 94vw; max-height: 82vh;
    object-fit: contain;
    border-radius: 4px;
    user-select: none; pointer-events: none;
  }
  #lb-close {
    position: absolute; top: 1rem; right: 1.2rem;
    font-size: 1.6rem; color: #fff; background: none; border: none;
    cursor: pointer; line-height: 1; padding: 0.5rem;
  }
  #lb-prev, #lb-next {
    position: absolute; top: 50%; transform: translateY(-50%);
    font-size: 2.5rem; color: #fff; background: none; border: none;
    cursor: pointer; padding: 0.5rem 1rem; line-height: 1; opacity: 0.7;
  }
  #lb-prev { left: 0.5rem; }
  #lb-next { right: 0.5rem; }
  @media (min-width: 769px) { #lb-overlay { display: none !important; } }

  /* ── COLLAGE STICKERS ── */
  .stk-layer {
    position: fixed; inset: 0;
    pointer-events: none; z-index: 10;
    overflow: hidden;
  }
  .stk {
    position: absolute; user-select: none;
    will-change: transform;
    filter: drop-shadow(0 4px 14px rgba(0,0,0,0.2));
  }
  @media (max-width: 900px) { .stk { display: none; } }

  /* ── GUMMY BEAR SCROLL-TO-TOP ── */
  #gummy-btn {
    position: fixed;
    bottom: 2rem; right: 2rem;
    width: 72px;
    z-index: 100;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0;
    transform: rotate(-16deg);
    filter: drop-shadow(0 4px 14px rgba(0,0,0,0.25));
    transition: transform 0.2s ease;
  }
  #gummy-btn:hover { transform: rotate(-16deg) scale(1.12); }

  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-video {
    position: absolute;
    top: 50%; left: 50%;
    width: 100vh; height: 100vw;
    object-fit: cover;
    transform: translate(-50%, -50%) rotate(270deg);
    z-index: 0;
    will-change: transform;
  }
  @media (max-width: 768px) {
    .hero-video {
      width: 100lvh; height: 100lvw;
      min-width: 100lvh; min-height: 100lvw;
      transform: translate(-50%, -50%) rotate(270deg);
      object-fit: cover;
    }
    .hero-overlay { background: rgba(0,0,0,0.20) !important; }
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.20);
    z-index: 1;
  }
  .hero-content {
    position: relative; z-index: 2;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  }
  .hero-title {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(3.5rem, 14vw, 10rem);
    color: #fff;
    line-height: 1;
    margin: 0;
    display: flex; flex-direction: column; align-items: center;
    gap: 1.2rem;
  }
  .word { display: block; }
