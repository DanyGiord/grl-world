  .order-remove svg { display: block; pointer-events: none; }
  .order-empty {
    font-family: "TAN-NIMBUS", sans-serif;
    color: rgba(255,255,255,0.25); font-size: 0.65rem;
    letter-spacing: 0.12em; text-align: center;
    padding: 2rem 0; line-height: 1.8;
  }
  #order-footer {
    padding: 1rem 1.5rem 2rem;
    border-top: 1px solid rgba(246,170,217,0.2);
    display: flex; flex-direction: column; gap: 0.9rem;
  }
  #order-total-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0 0.2rem;
  }
  #order-total-label {
    font-family: "TAN-NIMBUS", sans-serif;
    color: rgba(255,255,255,0.5); font-size: 0.65rem; letter-spacing: 0.2em;
  }
  #order-total-value {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #f6aad9; font-size: 1rem; letter-spacing: 0.12em;
  }
  #order-dm {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
    text-align: center; font-family: "TAN-NIMBUS", sans-serif;
    color: #1c181b; background: #f6aad9;
    border-radius: 2px; padding: 14px 20px;
    text-decoration: none; font-size: 0.72rem;
    letter-spacing: 0.2em;
    transition: background 0.25s, color 0.25s;
  }
  #order-dm img { width: 100px; height: auto; pointer-events: none; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.35)); }
  #order-dm:hover { background: #fff; }

  /* ── CARD ADD BUTTON ── */
  /* ── CARD SLAY ADD BUTTON ── */
  .card-add {
    position: absolute !important;
    bottom: 8px !important; right: 8px !important;
    z-index: 999 !important;
    width: 56px !important; height: auto !important;
    background: none !important; border: none !important;
    padding: 0 !important; cursor: pointer !important;
    opacity: 1 !important; visibility: visible !important; pointer-events: auto !important;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3)) !important;
    transform: rotate(8deg) !important;
    transition: transform 0.2s !important;
  }
  .card-add img { width: 100% !important; display: block !important; }
  .card-add:hover { transform: rotate(8deg) scale(1.15) !important; }
  .card.card-selected .card-add { opacity: 0.5 !important; }
  .card.card-selected::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(70,100,65,0.25); z-index: 3; pointer-events: none;
  }

  /* ── SLAY BADGE ── */
  #slay-badge {
    position: absolute; top: -5px; right: -5px;
    background: #466441; color: #fff;
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: 0.55rem; letter-spacing: 0;
    width: 20px; height: 20px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transform: scale(0);
    pointer-events: none;
  }
  #slay-btn { position: relative; }

  /* ── SLAY ORDER BUTTON ── */
  #slay-btn {
    position: fixed;
    bottom: 2.2rem; left: 2rem;
    z-index: 100;
    display: block;
    cursor: pointer;
    opacity: 0;
    transform: rotate(12deg);
    text-decoration: none;
    filter: drop-shadow(0 6px 18px rgba(246,170,217,0.55));
    transition: filter 0.2s ease;
  }
  #slay-btn img {
    width: 90px;
    display: block;
    pointer-events: none;
  }
  #slay-btn:hover {
    filter: drop-shadow(0 8px 24px rgba(246,170,217,0.85));
  }
  @media (max-width: 480px) {
    #slay-btn img { width: 70px; }
    #slay-btn { bottom: 1.5rem; left: 1.2rem; }
    #gummy-btn { bottom: 1.5rem; right: 0.3rem; left: auto; width: 58px; }
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-video {
    position: absolute;
    top: 50%; left: 50%;
    width: 100vh; height: 100vw;
    object-fit: cover;
    transform: translate(-50%, -50%) rotate(270deg);
    z-index: 0;
    will-change: transform;
  }
  @media (max-width: 768px) {
    .hero-video {
      width: 100lvh; height: 100lvw;
      min-width: 100lvh; min-height: 100lvw;
      transform: translate(-50%, -50%) rotate(270deg);
      object-fit: cover;
    }
    .hero-overlay { background: rgba(0,0,0,0.20) !important; }
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.20);
    z-index: 1;
  }
  .hero-content {
    position: relative; z-index: 2;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  }
  .hero-title {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(3.5rem, 14vw, 10rem);
    color: #fff;
    line-height: 1;
    margin: 0;
    display: flex; flex-direction: column; align-items: center;
    gap: 1.2rem;
  }
  .word { display: block; }
  .hero-sub {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(0.65rem, 2vw, 1rem);
    color: #f6aad9;
    letter-spacing: 0.55em;
    margin: 0.5rem 0 0;
  }
  @media (max-width: 768px) {
    .hero-content {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
    }
    .hero-title {
      font-size: clamp(5rem, 22vw, 8rem);
      gap: 1.5rem;
    }
    .hero-sub {
      font-size: clamp(0.75rem, 3.5vw, 1rem);
    }
  }
  .back-link {
    position: absolute; top: 1.5rem; left: 1.5rem; z-index: 3;
    font-family: "TAN-NIMBUS", sans-serif;
    color: #fff; text-decoration: none;
    font-size: 0.78rem; letter-spacing: 0.15em;
    opacity: 0.8; transition: opacity 0.2s;
  }
  .back-link:hover { opacity: 1; }
  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%); z-index: 3;
    font-family: "TAN-NIMBUS", sans-serif;
    color: rgba(255,255,255,0.55);
    font-size: 0.6rem; letter-spacing: 0.35em; text-decoration: none;
  }

  /* ── MARQUEE ── */
  .marquee-wrap {
    overflow: hidden; background: #466441;
    padding: 0.9rem 0; white-space: nowrap;
  }
  .marquee-track {
    display: inline-flex;
    animation: marquee 36s linear infinite;
  }
  .marquee-item {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #fcd8da; font-size: 0.72rem; letter-spacing: 0.2em;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── COLLECTION ── */
  .collection {
    padding: 4rem 1rem;
    max-width: 1300px;
    margin: 0 auto;
    display: flex; flex-direction: column; gap: 1rem;
  }

  /* ── GROUP LABEL ── */
  .group-label {
    display: flex; align-items: baseline; gap: 1.2rem;
    padding: 3rem 0 0.5rem;
    border-bottom: 2px solid #466441;
    margin-bottom: 0.25rem;
    overflow: hidden;
  }
  .group-num {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #fcd8da; line-height: 1;
    -webkit-text-stroke: 2px #466441;
    display: block;
  }
  .group-name {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(0.75rem, 2vw, 1.2rem);
    color: #466441; letter-spacing: 0.45em;
    display: block; flex: 1;
  }
  .group-price {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    color: #1c181b; letter-spacing: 0.2em;
    background: #f6aad9; border-radius: 999px;
    padding: 0.3rem 1.2rem;
    margin-left: auto;
  }

  /* ── CARD ── */
  .card {
    display: block; overflow: hidden;
    position: relative; background: #e8b4b8;
    text-decoration: none;
  }
  .card img, .card video {
    width: 100%; height: 110%;
    object-fit: cover; display: block;
    transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  .card:hover img, .card:hover video {
    transform: scale(1.06) translateY(0%) !important;
  }
  .card-hover {
    position: absolute; inset: 0;
    display: flex; align-items: flex-end; padding: 1.2rem;
    background: linear-gradient(to top, rgba(28,24,27,0.6) 0%, transparent 55%);
    opacity: 0; transition: opacity 0.35s ease;
  }
  .card:hover .card-hover { opacity: 1; }
  .card-hover span {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #fff; font-size: 0.62rem; letter-spacing: 0.28em;
  }

  /* ── EDITORIAL ROW ── */
  .editorial-row {
    display: grid; grid-template-columns: 2fr 1fr;
    gap: 1rem; height: 600px; overflow: hidden;
  }
  .editorial-row--reverse { grid-template-columns: 1fr 2fr; }
  .editorial-row--reverse .ed-stack { order: -1; }
  .ed-big { height: 100%; min-height: 0; }
  .ed-big .card { height: 100%; }
  .ed-stack { display: grid; grid-template-rows: 1fr 1fr; gap: 1rem; height: 100%; min-height: 0; }
  .ed-stack .card { height: 100%; min-height: 0; }

  @media (max-width: 700px) {
    .editorial-row, .editorial-row--reverse {
      grid-template-columns: 1fr; height: auto; overflow: visible;
    }
    .editorial-row--reverse .ed-stack { order: 0; }
    .ed-big .card { aspect-ratio: 3/4; height: auto; }
    .ed-stack { height: auto; }
    .ed-stack .card { aspect-ratio: 3/4; height: auto; }
  }

  /* ── GRID 3 ── */
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .grid-3 .card { aspect-ratio: 3/4; }
  @media (max-width: 700px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }

  /* ── GRID 4 ── */
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .grid-4 .card { aspect-ratio: 2/3; }
  @media (max-width: 700px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }

  /* ── GRID 2 ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .grid-2 .card { aspect-ratio: 4/5; }

  /* ── PAIR ── */
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; height: 520px; overflow: hidden; }
  .pair .card { height: 100%; min-height: 0; }
  @media (max-width: 700px) {
    .pair { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .pair .card { aspect-ratio: 3/4; height: auto; }
  }

  /* ── SPAN 2 CARD ── */
  .card-span2 { grid-column: span 2; aspect-ratio: 4/3; }

  /* ── VIDEO FEATURE ── */
  .card-video { aspect-ratio: 16/9; width: 100%; }

  /* ── GYM VIDEOS: vertical portrait + wide side by side ── */
  .gym-videos {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
    height: 600px;
    overflow: hidden;
  }
  .card-vertical { height: 100%; }
  .card-vertical video { width: 100%; height: 100%; object-fit: cover; }
  .card-video-side { height: 100%; }
  .card-video-side video { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 700px) {
    .gym-videos { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .card-vertical { aspect-ratio: 9/16; height: auto; }
    .card-video-side { aspect-ratio: 16/9; height: auto; }
  }

  /* ── MISSION + CTA (unified dark block) ── */
  .mission {
    background: #466441;
    padding: 0 2rem;
  }
  .mission-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 0 4rem;
  }
  .mission-top-line {
    width: 100%;
    height: 1px;
    background: rgba(246,170,217,0.35);
    margin-bottom: 4rem;
  }
  .mission-layout {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 4rem;
    align-items: start;
    overflow: visible;
  }
  .mission-left { overflow: visible; }
  .mission-title {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    color: #f6aad9;
    line-height: 1.15;
    margin: 0;
    position: sticky;
    top: 2rem;
  }
  .mission-body {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(0.82rem, 1.6vw, 1.1rem);
    color: rgba(255,255,255,0.82);
    line-height: 1.85;
    margin: 0;
  }

  .cta-block {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 0 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .cta-divider {
    width: 100%;
    height: 1px;
    background: rgba(246,170,217,0.35);
    margin-bottom: 1rem;
  }
  .cta-label {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #f6aad9;
    font-size: clamp(0.8rem, 2vw, 1.1rem);
    letter-spacing: 0.4em;
    margin: 0;
  }
  .cta-btn {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #466441;
    background: #f6aad9;
    border: 2px solid #f6aad9;
    border-radius: 2px;
    padding: 16px 56px;
    text-decoration: none;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    letter-spacing: 0.2em;
    display: inline-block;
    transition: background 0.3s, color 0.3s;
  }
  .cta-btn:hover {
    background: transparent;
    color: #f6aad9;
  }

  @media (max-width: 700px) {
    .mission-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .mission-title { position: static; }
  }

  /* ── MOBILE COMPREHENSIVE ── */
  @media (max-width: 600px) {

    /* Collection padding */
    .collection { padding: 2rem 0.75rem; }

    /* Group label — single row */
    .group-label {
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.5rem;
      padding: 1.8rem 0 0.5rem;
      overflow: hidden;
    }
    .group-num { font-size: clamp(1.6rem, 8vw, 2.4rem); flex-shrink: 0; }
    .group-name { font-size: clamp(0.55rem, 2.8vw, 0.85rem); letter-spacing: 0.2em; flex: 1; min-width: 0; }
    .group-price {
      margin-left: 0;
      flex-shrink: 0;
      font-size: 0.55rem;
      padding: 0.18rem 0.6rem;
      white-space: nowrap;
    }
    .size-guide-btn { flex-shrink: 0; font-size: 0.48rem; padding: 0.2rem 0.5rem; white-space: nowrap; }

    /* Category filter */
    #cat-filter { padding: 1rem; gap: 0.5rem; }
    .cat-btn { padding: 0.38rem 0.9rem; font-size: 0.55rem; letter-spacing: 0.18em; }

    /* Grid 2 — 1 column */
    .grid-2 { grid-template-columns: 1fr; }
    .grid-2 .card { aspect-ratio: 4/5; }

    /* Grid 3 — 2 columns (already set at 700px, keep) */

    /* Card hover — always show on mobile (no hover state) */
    .card-hover { opacity: 1; background: linear-gradient(to top, rgba(28,24,27,0.55) 0%, transparent 40%); }

    /* Badges / stickers smaller */
    .stock-badge { font-size: 0.42rem; padding: 3px 7px; }
    .worn-by { font-size: 0.4rem; padding: 3px 9px; bottom: 48px; }
    .card-add { width: 44px !important; }
    .card-share { width: 26px; height: 26px; right: 58px; top: 6px; }

    /* Lookbook */
    .lookbook-section { height: 55vh; min-height: 320px; }
    .lookbook-title { font-size: clamp(2rem, 9vw, 3.5rem); }
    .lookbook-text { padding: 0 5%; }

    /* Mission */
    .mission { padding: 0 1.2rem; }
    .mission-inner { padding: 4rem 0 3rem; }
    .cta-block { padding: 3rem 0 4rem; }
    .cta-btn { padding: 14px 32px; font-size: clamp(0.75rem, 3.5vw, 0.9rem); }

    /* Size modals */
    #size-modal-inner { padding: 2rem 1.5rem; width: calc(100vw - 2.5rem); }
    #size-options { gap: 0.5rem; }
    .size-btn { padding: 0.6rem 0.8rem; font-size: 0.65rem; min-width: 44px; }
    #size-guide-inner { padding: 2rem 1.5rem; width: calc(100vw - 2rem); }
    #size-guide-table th, #size-guide-table td { padding: 0.5rem 0.6rem; font-size: 0.6rem; }

    /* Reviews */
    .reviews-section { padding: 4rem 0 4rem; }
    .reviews-header { padding: 0 1.2rem; margin-bottom: 2.5rem; }
    .reviews-label { font-size: clamp(1.6rem, 8vw, 2.5rem); }
  }


  /* ── CLOUDS ── */
  .pink-bg-area {
    position: relative;
    overflow: hidden;
  }
  .cloud-layer {
    position: absolute; inset: 0;
    pointer-events: none; z-index: 0;
  }
  .cloud-layer .cl {
    position: absolute; left: 0; width: 320px; will-change: transform;
  }
  @media (max-width: 767px) {
    .cloud-layer .cl { width: 180px; }
  }

  /* ── CURTAIN ── */
  #entry-curtain {
    position: fixed; inset: 0; background: #f6aad9;
    z-index: 9999; transform-origin: top; will-change: transform;
  }

  /* ── SIZE SELECTOR MODAL ── */
  #size-modal {
    display: none; position: fixed; inset: 0; z-index: 10500;
    background: rgba(0,0,0,0.78); align-items: center; justify-content: center;
  }
  #size-modal-inner {
    background: #1c181b; border-radius: 10px; padding: 2.5rem 2.8rem;
    display: flex; flex-direction: column; align-items: center; gap: 1.8rem;
    visibility: hidden; opacity: 0;
    border: 1px solid rgba(246,170,217,0.15);
  }
  #size-modal-title {
    font-family: "TAN-NIMBUS", sans-serif; color: #f6aad9;
    font-size: 0.82rem; letter-spacing: 0.35em; margin: 0;
  }
  #size-options { display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
  .size-btn {
    font-family: "TAN-NIMBUS", sans-serif;
    background: transparent; border: 1.5px solid rgba(246,170,217,0.35);
    color: rgba(255,255,255,0.8); cursor: pointer; border-radius: 4px;
    padding: 0.7rem 1rem; font-size: 0.72rem; letter-spacing: 0.15em;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
    min-width: 52px; text-align: center;
  }
  .size-btn:hover {
    background: #f6aad9; border-color: #f6aad9; color: #1c181b;
    transform: translateY(-2px);
  }
  .size-btn:active { transform: translateY(0); }
  #size-modal-cancel {
    font-family: "TAN-NIMBUS", sans-serif; background: none; border: none;
    color: rgba(255,255,255,0.3); cursor: pointer; font-size: 0.6rem;
    letter-spacing: 0.25em; transition: color 0.2s; padding: 0;
  }
  #size-modal-cancel:hover { color: rgba(255,255,255,0.65); }

  /* ── SIZE GUIDE MODAL ── */
  #size-guide-modal {
    display: none; position: fixed; inset: 0; z-index: 10600;
    background: rgba(0,0,0,0.82); align-items: center; justify-content: center;
    padding: 1rem;
  }
  #size-guide-inner {
    background: #1c181b; border-radius: 10px; padding: 2.5rem 2.8rem;
    position: relative; min-width: 320px; max-width: 94vw;
    visibility: hidden; opacity: 0;
    border: 1px solid rgba(246,170,217,0.15);
  }
  #size-guide-close {
    position: absolute; top: 1rem; right: 1.2rem;
    background: none; border: none; color: rgba(255,255,255,0.4);
    font-size: 1.1rem; cursor: pointer; transition: color 0.2s; padding: 0.3rem;
  }
  #size-guide-close:hover { color: #f6aad9; }
  #size-guide-title {
    font-family: "TAN-NIMBUS", sans-serif; color: #f6aad9;
    font-size: 0.9rem; letter-spacing: 0.3em; margin: 0 0 1.8rem; text-align: center;
  }
  #size-guide-table { width: 100%; border-collapse: collapse; }
  #size-guide-table th, #size-guide-table td {
    font-family: "TAN-NIMBUS", sans-serif; text-align: center;
    padding: 0.65rem 1.2rem; font-size: 0.68rem; letter-spacing: 0.12em;
  }
  #size-guide-table th {
    color: rgba(246,170,217,0.7);
    border-bottom: 1px solid rgba(246,170,217,0.2);
  }
  #size-guide-table td { color: rgba(255,255,255,0.78); }
  #size-guide-table tbody tr:nth-child(even) td { background: rgba(255,255,255,0.04); }
  #size-guide-note {
    font-family: "TAN-NIMBUS", sans-serif; color: rgba(255,255,255,0.35);
    font-size: 0.58rem; letter-spacing: 0.15em; margin: 1.5rem 0 0;
    text-align: center;
  }
  .size-guide-btn {
    font-family: "TAN-NIMBUS", sans-serif; background: transparent;
    border: 1px solid rgba(70,100,65,0.5); color: #466441;
    cursor: pointer; font-size: 0.55rem; letter-spacing: 0.2em;
    padding: 0.28rem 0.75rem; border-radius: 2px;
    transition: background 0.2s, color 0.2s;
    align-self: center;
  }
  .size-guide-btn:hover { background: #466441; color: #fcd8da; }

  /* ── CATEGORY FILTER ── */
  #cat-filter {
    display: flex; gap: 0.6rem; padding: 1.2rem 1.5rem;
    max-width: 1300px; margin: 0 auto;
    flex-wrap: wrap;
  }
  .cat-btn {
