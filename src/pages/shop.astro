  /* ─── CLOUDS (always) ─── */
  {
    const W = window.innerWidth;
    const clouds = document.querySelectorAll<HTMLElement>(".cloud-layer .cl");
    const n = clouds.length;
    const yDrifts = [14,-11,18,-9,12,-16,10,-13,15,-8,20,-12,16];
    clouds.forEach((el, i) => {
      const speed   = parseFloat(el.dataset.speed || "80");
      const yPct    = parseFloat(el.dataset.y     || "50");
      const scale   = parseFloat(el.dataset.scale || "1");
      const opacity = parseFloat(el.dataset.op    || "0.35");
      const cloudW = 320 * scale;
      gsap.set(el, { top: `${yPct}%`, scale, opacity, x: -cloudW });
      gsap.to(el, { x: W + cloudW, duration: speed, repeat: -1, ease: "none", delay: -(speed * i / n) });
      gsap.to(el, { y: yDrifts[i % yDrifts.length], duration: speed / 9, repeat: -1, yoyo: true, ease: "sine.inOut" });
    });
  }

  mm.add("(prefers-reduced-motion: no-preference)", () => {

    /* ─── ENTRY CURTAIN ─── */
    gsap.to(entryCurtain, {
      scaleY: 0,
      duration: 0.7,
      ease: "power3.inOut",
      onComplete: () => entryCurtain.remove(),
    });

    /* ─── HERO ─── */
    gsap.from(".word", {
      y: 80, autoAlpha: 0, duration: 1.3, ease: "power3.out",
      stagger: 0.15, delay: 0.4,
    });
    gsap.from(".hero-sub",    { y: 30,  autoAlpha: 0, duration: 0.9, ease: "power2.out", delay: 0.85 });
    gsap.from(".back-link",   { x: -20, autoAlpha: 0, duration: 0.7, ease: "power2.out", delay: 0.5 });
    gsap.from(".scroll-hint", { autoAlpha: 0, duration: 0.7, delay: 1.2 });

    /* ─── HERO PARALLAX ─── */
    gsap.to(".hero-video", {
      scale: 1.12, ease: "none",
      scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
    });

    gsap.to(".scroll-hint", {
      autoAlpha: 0,
      scrollTrigger: { trigger: ".hero", start: "20% top", end: "40% top", scrub: true },
    });

    /* ─── MARQUEE ─── */
    gsap.fromTo(".marquee-wrap",
      { opacity: 0 },
      { opacity: 1, duration: 0.8,
        scrollTrigger: { trigger: ".marquee-wrap", start: "top 100%", once: true } }
    );

    /* ─── GROUP LABELS ─── */
    document.querySelectorAll(".group-label").forEach((label) => {
      const num  = label.querySelector(".group-num");
      const name = label.querySelector(".group-name");
      const st   = { trigger: label, start: "top 100%", once: true };
      gsap.from(label, { scaleX: 0, transformOrigin: "left", duration: 0.9, ease: "power3.out", scrollTrigger: st });
      gsap.fromTo(num,  { x: -50, opacity: 0 }, { x: 0, opacity: 1, duration: 0.9, ease: "power3.out", delay: 0.15, scrollTrigger: st });
      gsap.fromTo(name, { x: 30,  opacity: 0 }, { x: 0, opacity: 1, duration: 0.7, ease: "power2.out", delay: 0.3,  scrollTrigger: st });
    });

    /* ─── CARDS: FADE REVEAL + IMAGE PARALLAX ─── */
    document.querySelectorAll(".card").forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 28 },
        { opacity: 1, y: 0, duration: 0.85, ease: "power3.out",
          scrollTrigger: { trigger: card, start: "top 102%", once: true } }
      );

      const media = card.querySelector("img, video");
      if (media) {
        gsap.fromTo(media, { y: "-8%" }, {
          y: "8%", ease: "none",
          scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: true },
        });
      }
    });

    window.addEventListener("load", () => {
      ScrollTrigger.refresh();
      // Fallback: if any animated element is still invisible after layout settles, force it visible
      setTimeout(() => {
        document.querySelectorAll<HTMLElement>(
          ".review-card, .reviews-eyebrow, .reviews-label, .mission-title, .mission-body, .cta-label, .cta-btn, .lookbook-label, .lookbook-title, .lookbook-sub, .cat-btn, .marquee-wrap"
        ).forEach(el => {
          const computed = window.getComputedStyle(el);
          if (parseFloat(computed.opacity) < 0.1) gsap.set(el, { opacity: 1, y: 0, x: 0, visibility: "visible" });
        });
      }, 800);
    });
    setTimeout(() => ScrollTrigger.refresh(), 1500);

    /* ─── MISSION + CTA ─── */
    gsap.from(".mission-top-line", {
      scaleX: 0, transformOrigin: "left", duration: 1.2, ease: "power3.out",
      scrollTrigger: { trigger: ".mission", start: "top bottom", once: true },
    });
    gsap.fromTo(".mission-title",
      { opacity: 0, y: 0 },
      { opacity: 1, duration: 1, ease: "power2.out", delay: 0.2,
        scrollTrigger: { trigger: ".mission", start: "top bottom", once: true } }
    );
    gsap.fromTo(".mission-body",
      { opacity: 0, y: 35 },
      { opacity: 1, y: 0, duration: 1.1, ease: "power2.out", delay: 0.4,
        scrollTrigger: { trigger: ".mission", start: "top bottom", once: true } }
    );
    gsap.from(".cta-divider", {
      scaleX: 0, transformOrigin: "left", duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".cta-block", start: "top bottom", once: true },
    });
    gsap.fromTo(".cta-label",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, delay: 0.2,
        scrollTrigger: { trigger: ".cta-block", start: "top bottom", once: true } }
    );
    gsap.fromTo(".cta-btn",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.7, delay: 0.4,
        scrollTrigger: { trigger: ".cta-block", start: "top bottom", once: true } }
    );

    /* ─── LOOKBOOK PARALLAX ─── */
    document.querySelectorAll<HTMLElement>(".lookbook-section").forEach(section => {
      const img = section.querySelector<HTMLElement>(".lookbook-img");
      const label = section.querySelector<HTMLElement>(".lookbook-label");
      const title = section.querySelector<HTMLElement>(".lookbook-title");
      const sub = section.querySelector<HTMLElement>(".lookbook-sub");
      if (img) {
        gsap.fromTo(img, { scale: 1.12 }, {
          scale: 1, ease: "none",
          scrollTrigger: { trigger: section, start: "top bottom", end: "bottom top", scrub: true },
        });
      }
      if (label) gsap.fromTo(label, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.8, scrollTrigger: { trigger: section, start: "top bottom", once: true } });
      if (title) gsap.fromTo(title, { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 1.1, delay: 0.15, ease: "power3.out", scrollTrigger: { trigger: section, start: "top bottom", once: true } });
      if (sub) gsap.fromTo(sub, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, delay: 0.4, scrollTrigger: { trigger: section, start: "top bottom", once: true } });
    });

    /* ─── REVIEWS ─── */
    gsap.fromTo(".reviews-eyebrow",
      { opacity: 0, y: 15 },
      { opacity: 1, y: 0, duration: 0.6,
        scrollTrigger: { trigger: ".reviews-section", start: "top bottom", once: true } }
    );
    gsap.fromTo(".reviews-label",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.9, delay: 0.1, ease: "power3.out",
        scrollTrigger: { trigger: ".reviews-section", start: "top bottom", once: true } }
    );
    gsap.fromTo(".review-card",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, stagger: 0.1, duration: 0.7, ease: "power2.out",
        scrollTrigger: { trigger: ".reviews-track", start: "top bottom", once: true } }
    );

    /* ─── CAT FILTER ─── */
    gsap.fromTo(".cat-btn",
      { opacity: 0, y: 15 },
      { opacity: 1, y: 0, stagger: 0.08, duration: 0.5, ease: "power2.out",
        scrollTrigger: { trigger: "#cat-filter", start: "top 100%", once: true } }
    );

    /* ─── BACK LINK EXIT ─── */
    const backLink = document.querySelector(".back-link") as HTMLAnchorElement | null;
    if (backLink) {
      backLink.addEventListener("click", (e) => {
        e.preventDefault();
        const href = backLink.getAttribute("href") || "/";
        const curtain = document.createElement("div");
        curtain.style.cssText = "position:fixed;inset:0;background:#f6aad9;z-index:9999;transform-origin:bottom;will-change:transform;";
        gsap.set(curtain, { scaleY: 0 });
        document.body.appendChild(curtain);
        gsap.to(".word, .hero-sub", { y: -40, autoAlpha: 0, duration: 0.3, stagger: 0.06, ease: "power2.in" });
        gsap.to(curtain, {
          scaleY: 1, duration: 0.65, ease: "power3.inOut",
          onComplete: () => { window.location.href = href; },
        });
      });
    }
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    entryCurtain.remove();
    document.querySelectorAll(".card").forEach(c => {
      (c as HTMLElement).style.clipPath = "none";
    });
  });

  /* ── MOBILE LIGHTBOX ── */
  (function () {

    const overlay   = document.getElementById("lb-overlay")!;
    const lbImg     = document.getElementById("lb-img") as HTMLImageElement;
    const lbCat     = document.getElementById("lb-cat")!;
    const lbCounter = document.getElementById("lb-counter")!;
    const btnClose  = document.getElementById("lb-close")!;
    const btnPrev   = document.getElementById("lb-prev")!;
    const btnNext   = document.getElementById("lb-next")!;
    const lbSlay = document.getElementById("lb-slay") as HTMLButtonElement;

    // Build groups per category
    type Group = { name: string; imgs: HTMLImageElement[]; cards: HTMLElement[] };
    const groups: Group[] = [];
    const imgToGroup = new Map<HTMLImageElement, { group: Group; idx: number }>();

    document.querySelectorAll<HTMLElement>(".group-label").forEach((label) => {
      const name = label.querySelector(".group-name")?.textContent?.trim() || "";
      const imgs: HTMLImageElement[] = [];
      const cards: HTMLElement[] = [];
      let el = label.nextElementSibling;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLImageElement>(".card img").forEach(img => {
          if (img.closest(".card-add")) return;
          const card = img.closest<HTMLElement>(".card");
          if (card) { imgs.push(img); cards.push(card); }
        });
        el = el.nextElementSibling;
      }
      const group: Group = { name, imgs, cards };
      groups.push(group);
      imgs.forEach((img, idx) => imgToGroup.set(img, { group, idx }));
    });

    let currentGroup: Group = groups[0];
    let currentIdx = 0;

    const lbSlayLabel = document.getElementById("lb-slay-label")!;

    function updateUI() {
      lbImg.src = currentGroup.imgs[currentIdx].src;
      lbCat.textContent = currentGroup.name;
      lbCounter.textContent = `${currentIdx + 1} / ${currentGroup.imgs.length}`;
      const card = currentGroup.cards[currentIdx];
      const added = !!((window as any).__grlIsAdded?.(card));
      lbSlay.classList.toggle("lb-slay-added", added);
      lbSlayLabel.textContent = added ? "ORDERED ✓" : "ADD TO ORDER";
    }

    function open(img: HTMLImageElement) {
      const info = imgToGroup.get(img);
      if (!info) return;
      currentGroup = info.group;
      currentIdx = info.idx;
      updateUI();
      gsap.set(overlay, { display: "flex" });
      gsap.fromTo(overlay, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3, ease: "power2.out" });
      document.body.style.overflow = "hidden";
      // pop-in + wobble loop
      gsap.killTweensOf(lbSlay);
      gsap.fromTo(lbSlay,
        { scale: 0, rotation: 20, autoAlpha: 0 },
        { scale: 1, rotation: 8, autoAlpha: 1, duration: 0.5, delay: 0.25, ease: "back.out(3)",
          onComplete: () => gsap.to(lbSlay, { rotation: 12, duration: 1.4, repeat: -1, yoyo: true, ease: "sine.inOut" })
        }
      );
    }

    function close() {
      gsap.killTweensOf(lbSlay);
      gsap.to(overlay, { autoAlpha: 0, duration: 0.25, onComplete: () => gsap.set(overlay, { display: "none" }) });
      document.body.style.overflow = "";
    }

    function navigate(delta: number) {
      const dir = delta > 0 ? 40 : -40;
      currentIdx = (currentIdx + delta + currentGroup.imgs.length) % currentGroup.imgs.length;
      gsap.fromTo(lbImg, { autoAlpha: 0, x: dir }, { autoAlpha: 1, x: 0, duration: 0.25, ease: "power2.out" });
      updateUI();
    }

    // Wire up cards
    imgToGroup.forEach((_info, img) => {
      const card = img.closest("a");
      if (!card) return;
      card.addEventListener("click", (e) => { e.preventDefault(); open(img); });
    });

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => navigate(-1));
    btnNext.addEventListener("click", () => navigate(1));

    lbSlay.addEventListener("click", (e) => {
      e.stopPropagation();
      const card = currentGroup.cards[currentIdx];
      if (card && (window as any).__grlToggle) {
        (window as any).__grlToggle(card, () => {
          const added = !!((window as any).__grlIsAdded?.(card));
          lbSlay.classList.toggle("lb-slay-added", added);
          lbSlayLabel.textContent = added ? "ORDERED ✓" : "ADD TO ORDER";
          if (added) setTimeout(() => close(), 500);
        });
        gsap.fromTo(lbSlay, { scale: 0.8 }, { scale: 1, duration: 0.4, ease: "back.out(3)" });
      }
    });


    let startX = 0;
    overlay.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) navigate(dx < 0 ? 1 : -1);
    });
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
  })();

  /* ─── CARD HOVER LABELS ─── */
  {
    document.querySelectorAll<HTMLElement>(".group-label").forEach(label => {
      const cat = label.querySelector(".group-name")?.textContent?.trim() || "";
      let el = label.nextElementSibling;
      let n = 1;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLElement>(".card").forEach(card => {
          if (!card.querySelector("img, video")) return;
          const span = card.querySelector<HTMLElement>(".card-hover span");
          if (span) span.textContent = `${cat} ${String(n).padStart(2, "0")}`;
          n++;
        });
        el = el.nextElementSibling;
      }
    });
  }
</script>

