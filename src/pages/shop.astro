<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const entryCurtain = document.getElementById("entry-curtain")!;
  const mm = gsap.matchMedia();

  /* ─── ORDER SYSTEM (always runs) ─── */
  {
    const orderPanel    = document.getElementById("order-panel")!;
    const orderBackdrop = document.getElementById("order-backdrop")!;
    const orderItemsEl  = document.getElementById("order-items")!;
    const orderClose    = document.getElementById("order-close")!;
    const slayBadge     = document.getElementById("slay-badge")!;
    const slayBtn2      = document.getElementById("slay-btn") as HTMLAnchorElement | null;

    let orderItems: { name: string; price: string; src: string; card: Element }[] = [];

    // Build product names + prices by section
    const cardNames = new Map<Element, string>();
    const cardPrices = new Map<Element, string>();
    document.querySelectorAll<HTMLElement>(".group-label").forEach(label => {
      const cat = label.querySelector(".group-name")?.textContent?.trim() || "LOOK";
      const price = label.querySelector(".group-price")?.textContent?.trim() || "";
      let el = label.nextElementSibling;
      let n = 1;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLElement>(".card").forEach(card => {
          if (card.querySelector("img")) {
            cardNames.set(card, `${cat} ${n++}`);
            cardPrices.set(card, price);
          }
        });
        el = el.nextElementSibling;
      }
    });

    // Inject + buttons
    document.querySelectorAll<HTMLElement>(".card").forEach(card => {
      if (!card.querySelector("img")) return;
      const name = cardNames.get(card) || "ITEM";
      const btn = document.createElement("button");
      btn.className = "card-add";
      btn.innerHTML = `<img src="/img/collage/slay.png" alt="Add to order" />`;
      btn.setAttribute("aria-label", "Add to order");
      btn.setAttribute("type", "button");
      card.appendChild(btn);

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const idx = orderItems.findIndex(i => i.card === card);
        if (idx >= 0) {
          orderItems.splice(idx, 1);
          card.classList.remove("card-selected");
          updateBadge();
        } else {
          const img = card.querySelector("img") as HTMLImageElement;
          const price = cardPrices.get(card) || "";
          const doAdd = (size?: string) => {
            const itemName = size ? `${name} — ${size}` : name;
            orderItems.push({ name: itemName, price, src: img?.src || "", card });
            card.classList.add("card-selected");
            gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.35, ease: "back.out(3)" });
            if (img) flyToCart(img, slayBtn2);
            addRipple(card);
            updateBadge();
          };
          if ((window as any).__grlRequestSize) {
            (window as any).__grlRequestSize(doAdd);
          } else {
            doAdd();
          }
        }
      });
    });

    function flyToCart(srcEl: HTMLImageElement, targetEl: HTMLElement | null) {
      if (!targetEl) return;
      const from = srcEl.getBoundingClientRect();
      const to   = targetEl.getBoundingClientRect();
      const kiss = document.createElement("img");
      kiss.src = "/img/collage/kiss.png";
      const size = 220;
      Object.assign(kiss.style, {
        position: "fixed", zIndex: "99998", pointerEvents: "none",
        width: `${size}px`, height: "auto",
        top: `${from.top + from.height / 2 - size / 2}px`,
        left: `${from.left + from.width / 2 - size / 2}px`,
        filter: "drop-shadow(0 4px 12px rgba(246,170,217,0.6))",
      });
      document.body.appendChild(kiss);
      const toX = to.left + to.width / 2 - size / 2 - (from.left + from.width / 2 - size / 2);
      const toY = to.top  + to.height / 2 - size / 2 - (from.top  + from.height / 2 - size / 2);
      const tl = gsap.timeline({
        onComplete: () => {
          kiss.remove();
          if (slayBtn2) gsap.fromTo(slayBtn2, { scale: 1.4 }, { scale: 1, duration: 0.45, ease: "elastic.out(1.5, 0.4)" });
        }
      });
      tl.fromTo(kiss,
        { scale: 0, opacity: 1, rotation: -15 },
        { scale: 1, rotation: 10, duration: 0.4, ease: "back.out(3)" }
      )
      .to(kiss, { scale: 1.08, duration: 0.25, ease: "sine.inOut", yoyo: true, repeat: 1 })
      .to(kiss, { x: toX, y: toY, scale: 0.2, opacity: 0, duration: 0.55, ease: "power3.in" });
    }

    function addRipple(card: HTMLElement) {
      const ripple = document.createElement("span");
      Object.assign(ripple.style, {
        position: "absolute", inset: "0", zIndex: "5",
        background: "radial-gradient(circle, rgba(246,170,217,0.35) 0%, transparent 70%)",
        pointerEvents: "none", borderRadius: "inherit",
        transform: "scale(0)", opacity: "1",
      });
      card.appendChild(ripple);
      gsap.fromTo(ripple,
        { scale: 0, opacity: 0.8 },
        { scale: 2, opacity: 0, duration: 0.6, ease: "power2.out",
          onComplete: () => ripple.remove() }
      );
    }

    const orderTotalValue = document.getElementById("order-total-value")!;

    function updateTotal() {
      const sum = orderItems.reduce((acc, item) => {
        const n = parseInt(item.price.replace(/[^0-9]/g, ""), 10);
        return acc + (isNaN(n) ? 0 : n);
      }, 0);
      orderTotalValue.textContent = sum > 0 ? `${sum.toLocaleString("sr-RS")} RSD` : "0 RSD";
    }

    function updateBadge() {
      const n = orderItems.length;
      slayBadge.textContent = String(n);
      if (n > 0) {
        gsap.to(slayBadge, { autoAlpha: 1, scale: 1, duration: 0.3, ease: "back.out(2)" });
      } else {
        gsap.to(slayBadge, { autoAlpha: 0, scale: 0, duration: 0.2 });
      }
      updateTotal();
      (window as any).__grlUpdateWhatsApp?.();
    }

