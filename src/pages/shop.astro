        Object.assign(info.style, { display: "flex", flexDirection: "column", gap: "0.2rem", flex: "1" });

        const label = document.createElement("span");
        label.textContent = item.name;
        Object.assign(label.style, {
          fontFamily: "'TAN-NIMBUS', sans-serif",
          color: "#f6aad9", fontSize: "0.72rem", letterSpacing: "0.14em",
        });

        const priceEl = document.createElement("span");
        priceEl.textContent = item.price;
        Object.assign(priceEl.style, {
          fontFamily: "'TAN-NIMBUS', sans-serif",
          color: "#fff", fontSize: "0.8rem", letterSpacing: "0.1em",
        });

        info.appendChild(label);
        if (item.price) info.appendChild(priceEl);

        const del = document.createElement("button");
        del.setAttribute("aria-label", "Remove");
        del.textContent = "✕";
        Object.assign(del.style, {
          width: "30px", height: "30px", minWidth: "30px",
          display: "flex", alignItems: "center", justifyContent: "center",
          background: "#f6aad9", border: "none", borderRadius: "50%",
          cursor: "pointer", color: "#1c181b", fontSize: "1rem",
          fontWeight: "bold", fontFamily: "system-ui, sans-serif",
          lineHeight: "1", opacity: "1", visibility: "visible",
        });
        del.addEventListener("mouseenter", () => { del.style.background = "#e890c4"; });
        del.addEventListener("mouseleave", () => { del.style.background = "#f6aad9"; });
        del.addEventListener("click", () => {
          item.card.classList.remove("card-selected");
          orderItems.splice(idx, 1);
          updateBadge();
          renderPanel();
        });

        footer.appendChild(info);
        footer.appendChild(del);
        card.appendChild(img);
        card.appendChild(footer);
