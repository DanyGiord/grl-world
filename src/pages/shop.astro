        if (btn) gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.3, ease: "back.out(3)" });
        updateBadge();
        afterToggle?.();
      } else {
        const doAdd = (size?: string) => {
          const itemName = size ? `${name} — ${size}` : name;
          orderItems.push({ name: itemName, price, src, card });
          card.classList.add("card-selected");
          if (productImg) flyToCart(productImg, slayBtn2);
          addRipple(card as HTMLElement);
          if (btn) gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.3, ease: "back.out(3)" });
          updateBadge();
          afterToggle?.();
        };
        if ((window as any).__grlRequestSize) {
          (window as any).__grlRequestSize(doAdd);
        } else {
          doAdd();
        }
      }
    };
    (window as any).__grlIsAdded = (card: Element) => orderItems.some(i => i.card === card);
    (window as any).__grlOrderItems = () => orderItems.map(i => ({ name: i.name, price: i.price }));
  }

  /* ─── SIZE SELECTOR MODAL ─── */
