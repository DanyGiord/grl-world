  <p id="order-confirm-ig">Step into our world on Instagram<br><a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener"><strong>@gr1world</strong></a></p>
</div>

<!-- SIZE SELECTOR MODAL -->
<div id="size-modal">
  <div id="size-modal-inner">
    <p id="size-modal-title">SELECT YOUR SIZE</p>
    <div id="size-options">
      <button class="size-btn" data-size="XS">XS</button>
      <button class="size-btn" data-size="S">S</button>
      <button class="size-btn" data-size="M">M</button>
      <button class="size-btn" data-size="L">L</button>
      <button class="size-btn" data-size="XL">XL</button>
    </div>
    <button id="size-modal-cancel">CANCEL</button>
  </div>
</div>

<!-- SIZE GUIDE MODAL -->
<div id="size-guide-modal">
  <div id="size-guide-inner">
    <button id="size-guide-close">✕</button>
    <h3 id="size-guide-title">SIZE GUIDE</h3>
    <table id="size-guide-table">
      <thead><tr><th>SIZE</th><th>BUST</th><th>WAIST</th><th>HIPS</th></tr></thead>
      <tbody>
        <tr><td>XS</td><td>80–84</td><td>60–64</td><td>86–90</td></tr>
        <tr><td>S</td><td>84–88</td><td>64–68</td><td>90–94</td></tr>
        <tr><td>M</td><td>88–92</td><td>68–72</td><td>94–98</td></tr>
        <tr><td>L</td><td>92–96</td><td>72–76</td><td>98–102</td></tr>
        <tr><td>XL</td><td>96–100</td><td>76–80</td><td>102–106</td></tr>
      </tbody>
    </table>
    <p id="size-guide-note">Measurements in cm. When between sizes, size up.</p>
  </div>
</div>

