---
import Layout from "../layouts/Layout.astro";
import GradualBlur from "../components/GradualBlur.jsx";
---

<Layout
  title="Shop — GRL WORLD | Bikinis, Gym Sets & Stripe Sets"
  description="Shop GRL WORLD creative swimwear — bikinis, gym sets and stripe sets. Summer outfits for the beach. DM @gr1world to order."
  image="/img/shop/p5.jpg"
  url="https://grlworld.com/shop"
/>

<div id="entry-curtain"></div>

<div class="stk-layer" aria-hidden="true"></div>
<img id="gummy-btn" src="/img/collage/gummy-bear.png" />
<a id="slay-btn" href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" aria-label="Order now">
  <img src="/img/collage/slay.png" alt="SLAY — Order Now" />
  <span id="slay-badge">0</span>
</a>

<!-- ORDER PANEL -->
<div id="order-panel">
  <div id="order-header">
    <h3>YOUR ORDER</h3>
    <button id="order-close" aria-label="Close">✕</button>
  </div>
  <p id="order-hint">Click <strong>+</strong> on any look to add it</p>
  <div id="order-items"></div>
  <div id="order-footer">
    <div id="order-total-row">
      <span id="order-total-label">TOTAL</span>
      <span id="order-total-value">0 RSD</span>
    </div>
    <a id="order-dm" href="https://www.instagram.com/gr1world" target="_blank" rel="noopener">
      <img src="/img/collage/money.png" alt="" />
      PLACE ORDER
    </a>
  </div>
</div>
<div id="order-backdrop"></div>

<div id="order-confirm">
  <img id="order-confirm-martini" src="/img/collage/martini.png" alt="martini" />
  <p id="order-confirm-text">Take a martini.<br>Your order is on the way,<br><strong>girllll.</strong></p>
  <p id="order-confirm-ig">Step into our world on Instagram<br><a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener"><strong>@gr1world</strong></a></p>
</div>

<main>

  <!-- ── HERO ── -->
  <section class="hero">
    <video class="hero-video" src="/video/hero.mp4" autoplay muted loop playsinline></video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="word">GRL</span>
        <span class="word">WORLD</span>
      </h1>
      <p class="hero-sub">COLLECTION</p>
    </div>
    <a href="/" class="back-link">← BACK</a>
    <a href="#collection" class="scroll-hint">SCROLL ↓</a>
    <GradualBlur
      client:load
      target="parent"
      position="bottom"
      height="8rem"
      strength={3}
      divCount={8}
      curve="bezier"
      exponential={true}
      opacity={1}
    />
  </section>

  <!-- ── MARQUEE ── -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      {Array.from({ length: 8 }, () => (
        <span class="marquee-item">GRL WORLD &nbsp;·&nbsp; BIKINIS &nbsp;·&nbsp; GYM SET &nbsp;·&nbsp; STRIPE SET &nbsp;·&nbsp; DM TO ORDER &nbsp;·&nbsp;</span>
      ))}
    </div>
  </div>

  <!-- ── COLLECTION ── -->
  <section class="collection" id="collection">

    <!-- ══ BIKINIS ══ -->
    <div class="group-label">
      <span class="group-num">01</span>
      <span class="group-name">BIKINIS</span>
      <span class="group-price">3,490 RSD</span>
    </div>

    <div class="editorial-row">
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p5.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p26.jpg" alt="" loading="lazy" style="object-position: center 100%; transform: translateY(30%);" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p27.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <div class="grid-3">
      {[7,8,9,10,12,19].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/p${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <div class="pair">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p24.jpg" alt="" loading="lazy" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p25.jpg" alt="" loading="lazy" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <div class="grid-2">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p28.jpg" alt="" loading="lazy" style="object-position: center top;" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
        <img src="/img/shop/p31.jpg" alt="" loading="lazy" style="object-position: center top;" />
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <!-- ══ GYM SET ══ -->
    <div class="group-label">
      <span class="group-num">02</span>
      <span class="group-name">GYM SET</span>
      <span class="group-price">5,990 RSD</span>
    </div>

    <div class="editorial-row editorial-row--reverse">
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p15.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p16.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p14.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <!-- BLACK row -->
    <div class="grid-4">
      {["p4","p34","gym1","gym2"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- BLACK → GREY pair -->
    <div class="pair">
      {["p1","p6"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- GREY → BLUE row -->
    <div class="grid-3">
      {["p23","p30","p18"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- WHITE / LIGHT pair -->
    <div class="pair">
      {["p3","p2"].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>

    <!-- GYM VIDEO VERTICAL + WIDE VIDEO -->
    <div class="gym-videos">
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card card-vertical">
        <video src="/video/gymvideo.mp4" autoplay muted loop playsinline></video>
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card card-video-side">
        <video src="/video/v2.mp4" autoplay muted loop playsinline></video>
        <div class="card-hover"><span>DM TO ORDER</span></div>
      </a>
    </div>

    <!-- ══ STRIPE SET ══ -->
    <div class="group-label">
      <span class="group-num">03</span>
      <span class="group-name">STRIPE SET</span>
      <span class="group-price">3,990 RSD</span>
    </div>

    <div class="editorial-row">
      <div class="ed-big">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p20.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
      <div class="ed-stack">
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p21.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src="/img/shop/p22.jpg" alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      </div>
    </div>

    <div class="grid-3">
      {[11,13,17,29,33,32].map(n => (
        <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="card">
          <img src={`/img/shop/p${n}.jpg`} alt="" loading="lazy" />
          <div class="card-hover"><span>DM TO ORDER</span></div>
        </a>
      ))}
    </div>


  </section>

  <!-- ── MISSION ── -->
  <section class="mission">
    <div class="mission-inner">
      <div class="mission-top-line"></div>
      <div class="mission-layout">
        <div class="mission-left">
          <h2 class="mission-title">OUR<br>MISSION</h2>
        </div>
        <div class="mission-right">
          <p class="mission-body">GR1WORLD IS COMING SOON, LIKE A RAY OF SUNSHINE ON THE SHORE, BRINGING CREATIVE SWIMWEAR AND SUMMER OUTFITS FOR THE BEACH. EXPECT MAGICAL BIKINI COMBINATIONS THAT WILL HELP YOU SHINE LIKE SEA FOAM. GET READY TO EMBARK ON A JOURNEY WHERE BEAUTY DANCES WITH THE WAVES AND STYLE WHISPERS IN THE SEA BREEZE, AS GR1WORLD UNVEILS ITS ENCHANTING CREATIONS FOR YOU TO EMBRACE UNDER THE SUN'S GOLDEN GAZE.</p>
        </div>
      </div>
    </div>

    <!-- CTA inside mission block -->
    <div class="cta-block">
      <div class="cta-divider"></div>
      <p class="cta-label">Step into our world on Instagram</p>
      <a href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" class="cta-btn">
        @GR1WORLD
      </a>
    </div>
  </section>


</main>

<!-- ── MOBILE LIGHTBOX ── -->
<div id="lb-overlay">
  <button id="lb-close">✕</button>
  <p id="lb-cat"></p>
  <div id="lb-img-wrap">
    <img id="lb-img" src="" alt="" />
    <button id="lb-slay" aria-label="Add to order">
      <img src="/img/collage/slay.png" alt="SLAY" />
      <span id="lb-slay-label">ADD TO ORDER</span>
    </button>
  </div>
  <button id="lb-prev">‹</button>
  <button id="lb-next">›</button>
  <p id="lb-counter"></p>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const entryCurtain = document.getElementById("entry-curtain")!;
  const mm = gsap.matchMedia();

  /* ─── ORDER SYSTEM (always runs) ─── */
  {
    const orderPanel    = document.getElementById("order-panel")!;
    const orderBackdrop = document.getElementById("order-backdrop")!;
    const orderItemsEl  = document.getElementById("order-items")!;
    const orderClose    = document.getElementById("order-close")!;
    const slayBadge     = document.getElementById("slay-badge")!;
    const slayBtn2      = document.getElementById("slay-btn") as HTMLAnchorElement | null;

    let orderItems: { name: string; price: string; src: string; card: Element }[] = [];

    // Build product names + prices by section
    const cardNames = new Map<Element, string>();
    const cardPrices = new Map<Element, string>();
    document.querySelectorAll<HTMLElement>(".group-label").forEach(label => {
      const cat = label.querySelector(".group-name")?.textContent?.trim() || "LOOK";
      const price = label.querySelector(".group-price")?.textContent?.trim() || "";
      let el = label.nextElementSibling;
      let n = 1;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLElement>(".card").forEach(card => {
          if (card.querySelector("img")) {
            cardNames.set(card, `${cat} ${n++}`);
            cardPrices.set(card, price);
          }
        });
        el = el.nextElementSibling;
      }
    });

    // Inject + buttons
    document.querySelectorAll<HTMLElement>(".card").forEach(card => {
      if (!card.querySelector("img")) return;
      const name = cardNames.get(card) || "ITEM";
      const btn = document.createElement("button");
      btn.className = "card-add";
      btn.innerHTML = `<img src="/img/collage/slay.png" alt="Add to order" />`;
      btn.setAttribute("aria-label", "Add to order");
      btn.setAttribute("type", "button");
      card.appendChild(btn);

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const idx = orderItems.findIndex(i => i.card === card);
        if (idx >= 0) {
          orderItems.splice(idx, 1);
          card.classList.remove("card-selected");
        } else {
          const img = card.querySelector("img") as HTMLImageElement;
          const price = cardPrices.get(card) || "";
          orderItems.push({ name, price, src: img?.src || "", card });
          card.classList.add("card-selected");
          gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.35, ease: "back.out(3)" });
        }
        updateBadge();
      });
    });

    const orderTotalValue = document.getElementById("order-total-value")!;

    function updateTotal() {
      const sum = orderItems.reduce((acc, item) => {
        const n = parseInt(item.price.replace(/[^0-9]/g, ""), 10);
        return acc + (isNaN(n) ? 0 : n);
      }, 0);
      orderTotalValue.textContent = sum > 0 ? `${sum.toLocaleString("sr-RS")} RSD` : "0 RSD";
    }

    function updateBadge() {
      const n = orderItems.length;
      slayBadge.textContent = String(n);
      if (n > 0) {
        gsap.to(slayBadge, { autoAlpha: 1, scale: 1, duration: 0.3, ease: "back.out(2)" });
      } else {
        gsap.to(slayBadge, { autoAlpha: 0, scale: 0, duration: 0.2 });
      }
      updateTotal();
    }

    function renderPanel() {
      orderItemsEl.innerHTML = "";
      if (orderItems.length === 0) {
        orderItemsEl.innerHTML = `
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.2rem;padding:2.5rem 1rem;text-align:center;height:100%;min-height:300px;">
            <p style="font-family:'TAN-NIMBUS',sans-serif;color:rgba(255,255,255,0.85);font-size:0.85rem;letter-spacing:0.18em;line-height:1.9;margin:0;">
              NO ITEMS ADDED YET.<br>CLICK
            </p>
            <img src="/img/collage/slay.png" alt="SLAY" style="width:80px;filter:drop-shadow(0 2px 8px rgba(0,0,0,0.4));transform:rotate(8deg);" />
            <p style="font-family:'TAN-NIMBUS',sans-serif;color:rgba(255,255,255,0.85);font-size:0.85rem;letter-spacing:0.18em;line-height:1.9;margin:0;">
              ON ANY LOOK TO ADD IT.
            </p>
          </div>`;
        return;
      }
      orderItems.forEach((item, idx) => {
        const card = document.createElement("div");
        Object.assign(card.style, {
          position: "relative", borderRadius: "6px", overflow: "hidden",
          background: "#2a2427", flexShrink: "0",
        });

        const img = document.createElement("img");
        img.src = item.src; img.alt = item.name;
        Object.assign(img.style, {
          width: "100%", aspectRatio: "3/4", objectFit: "cover",
          display: "block", filter: "none",
        });

        const footer = document.createElement("div");
        Object.assign(footer.style, {
          display: "flex", alignItems: "center", justifyContent: "space-between",
          padding: "0.6rem 0.8rem",
          background: "rgba(28,24,27,0.85)",
        });

        const info = document.createElement("div");
        Object.assign(info.style, { display: "flex", flexDirection: "column", gap: "0.2rem", flex: "1" });

        const label = document.createElement("span");
        label.textContent = item.name;
        Object.assign(label.style, {
          fontFamily: "'TAN-NIMBUS', sans-serif",
          color: "#f6aad9", fontSize: "0.72rem", letterSpacing: "0.14em",
        });

        const priceEl = document.createElement("span");
        priceEl.textContent = item.price;
        Object.assign(priceEl.style, {
          fontFamily: "'TAN-NIMBUS', sans-serif",
          color: "#fff", fontSize: "0.8rem", letterSpacing: "0.1em",
        });

        info.appendChild(label);
        if (item.price) info.appendChild(priceEl);

        const del = document.createElement("button");
        del.setAttribute("aria-label", "Remove");
        del.textContent = "✕";
        Object.assign(del.style, {
          width: "30px", height: "30px", minWidth: "30px",
          display: "flex", alignItems: "center", justifyContent: "center",
          background: "#f6aad9", border: "none", borderRadius: "50%",
          cursor: "pointer", color: "#1c181b", fontSize: "1rem",
          fontWeight: "bold", fontFamily: "system-ui, sans-serif",
          lineHeight: "1", opacity: "1", visibility: "visible",
        });
        del.addEventListener("mouseenter", () => { del.style.background = "#e890c4"; });
        del.addEventListener("mouseleave", () => { del.style.background = "#f6aad9"; });
        del.addEventListener("click", () => {
          item.card.classList.remove("card-selected");
          orderItems.splice(idx, 1);
          updateBadge();
          renderPanel();
        });

        footer.appendChild(info);
        footer.appendChild(del);
        card.appendChild(img);
        card.appendChild(footer);
        orderItemsEl.appendChild(card);
      });
      gsap.from(orderItemsEl.children, { x: -20, opacity: 0, stagger: 0.06, duration: 0.3, ease: "power2.out", clearProps: "all" });
    }

    function openPanel() {
      renderPanel();
      gsap.set(orderPanel, { display: "flex", x: "-100%" });
      gsap.set(orderBackdrop, { display: "block" });
      gsap.to(orderPanel, { x: 0, duration: 0.4, ease: "power3.out" });
      gsap.fromTo(orderBackdrop, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.35 });
      document.body.style.overflow = "hidden";
    }

    function closePanel() {
      gsap.to(orderPanel, { x: "-100%", duration: 0.35, ease: "power3.in", onComplete: () => gsap.set(orderPanel, { display: "none" }) });
      gsap.to(orderBackdrop, { autoAlpha: 0, duration: 0.3, onComplete: () => gsap.set(orderBackdrop, { display: "none" }) });
      document.body.style.overflow = "";
    }

    orderClose.addEventListener("click", closePanel);
    orderBackdrop.addEventListener("click", closePanel);

    if (slayBtn2) {
      slayBtn2.addEventListener("click", (e) => { e.preventDefault(); openPanel(); });
    }

    const orderConfirm = document.getElementById("order-confirm")!;
    const orderConfirmMartini = document.getElementById("order-confirm-martini")!;
    const orderDm = document.getElementById("order-dm") as HTMLAnchorElement;
    const igUrl = orderDm.href;

    orderDm.addEventListener("click", (e) => {
      e.preventDefault();
      closePanel();
      gsap.set(orderConfirm, { display: "flex" });
      gsap.fromTo(orderConfirm, { autoAlpha: 0, scale: 0.85 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: "back.out(2)" });
      gsap.fromTo(orderConfirmMartini,
        { rotation: -20, scale: 0 },
        { rotation: 10, scale: 1, duration: 0.7, delay: 0.2, ease: "back.out(3)",
          onComplete: () => gsap.to(orderConfirmMartini, { rotation: 14, duration: 1.6, repeat: -1, yoyo: true, ease: "sine.inOut" })
        }
      );
      setTimeout(() => {
        gsap.to(orderConfirm, { autoAlpha: 0, duration: 0.8, ease: "power2.in",
          onComplete: () => gsap.set(orderConfirm, { display: "none" }) });
      }, 10000);
    });

    (window as any).__grlToggle = (card: Element) => {
      const name = cardNames.get(card) || "ITEM";
      const price = cardPrices.get(card) || "";
      const productImg = Array.from(card.querySelectorAll<HTMLImageElement>("img"))
        .find(img => !img.closest(".card-add"));
      const src = productImg?.src || "";
      const idx = orderItems.findIndex(i => i.card === card);
      if (idx >= 0) {
        orderItems.splice(idx, 1);
        card.classList.remove("card-selected");
      } else {
        orderItems.push({ name, price, src, card });
        card.classList.add("card-selected");
      }
      const btn = card.querySelector<HTMLButtonElement>(".card-add");
      if (btn) gsap.fromTo(btn, { scale: 0.9 }, { scale: 1, duration: 0.3, ease: "back.out(3)" });
      updateBadge();
    };
    (window as any).__grlIsAdded = (card: Element) => orderItems.some(i => i.card === card);
  }

  mm.add("(prefers-reduced-motion: no-preference)", () => {

    /* ─── SLAY ORDER BUTTON ANIMATIONS ─── */
    const slayBtn = document.getElementById("slay-btn") as HTMLAnchorElement | null;
    if (slayBtn) {
      gsap.set(slayBtn, { scale: 0, autoAlpha: 0, rotation: 12 });
      gsap.to(slayBtn, { rotation: 6, duration: 1.8, repeat: -1, yoyo: true, ease: "sine.inOut" });
      ScrollTrigger.create({
        trigger: ".hero",
        start: "bottom 80%",
        onEnter: () => gsap.to(slayBtn, { scale: 1, autoAlpha: 1, rotation: 12, duration: 0.7, ease: "back.out(2.5)" }),
        onLeaveBack: () => gsap.to(slayBtn, { scale: 0, autoAlpha: 0, duration: 0.3 }),
      });
      slayBtn.addEventListener("mouseenter", () => gsap.to(slayBtn, { scale: 1.15, duration: 0.2, ease: "back.out(2)" }));
      slayBtn.addEventListener("mouseleave", () => gsap.to(slayBtn, { scale: 1, duration: 0.25, ease: "power2.inOut" }));
    }

    /* ─── GUMMY BEAR SCROLL-TO-TOP ─── */
    const gummy = document.getElementById("gummy-btn") as HTMLElement | null;
    if (gummy) {
      // float animation
      gsap.to(gummy, { y: -10, duration: 2.9, repeat: -1, yoyo: true, ease: "sine.inOut" });

      // show after 40% of page scrolled
      ScrollTrigger.create({
        trigger: document.body,
        start: "40% top",
        onEnter: () => gsap.to(gummy, { autoAlpha: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }),
        onLeaveBack: () => gsap.to(gummy, { autoAlpha: 0, scale: 0.5, duration: 0.3 }),
      });

      gummy.addEventListener("click", () => {
        gsap.to(gummy, { rotation: -16 + 360, duration: 0.6, ease: "power2.inOut", onComplete: () => gsap.set(gummy, { rotation: -16 }) });
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    /* ─── ENTRY CURTAIN ─── */
    gsap.to(entryCurtain, {
      scaleY: 0,
      duration: 0.7,
      ease: "power3.inOut",
      onComplete: () => entryCurtain.remove(),
    });

    /* ─── HERO ─── */
    gsap.from(".word", {
      y: 80, autoAlpha: 0, duration: 1.3, ease: "power3.out",
      stagger: 0.15, delay: 0.4,
    });
    gsap.from(".hero-sub",    { y: 30,  autoAlpha: 0, duration: 0.9, ease: "power2.out", delay: 0.85 });
    gsap.from(".back-link",   { x: -20, autoAlpha: 0, duration: 0.7, ease: "power2.out", delay: 0.5 });
    gsap.from(".scroll-hint", { autoAlpha: 0, duration: 0.7, delay: 1.2 });

    /* ─── HERO PARALLAX ─── */
    gsap.to(".hero-video", {
      scale: 1.12, ease: "none",
      scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
    });

    gsap.to(".scroll-hint", {
      autoAlpha: 0,
      scrollTrigger: { trigger: ".hero", start: "20% top", end: "40% top", scrub: true },
    });

    /* ─── MARQUEE ─── */
    gsap.from(".marquee-wrap", {
      autoAlpha: 0, duration: 0.8,
      scrollTrigger: { trigger: ".marquee-wrap", start: "top 92%" },
    });

    /* ─── GROUP LABELS ─── */
    document.querySelectorAll(".group-label").forEach((label) => {
      const num  = label.querySelector(".group-num");
      const name = label.querySelector(".group-name");
      const st   = { trigger: label, start: "top 88%" };
      gsap.from(label, { scaleX: 0, transformOrigin: "left", duration: 0.9, ease: "power3.out", scrollTrigger: st });
      gsap.from(num,   { x: -50, autoAlpha: 0, duration: 0.9, ease: "power3.out", delay: 0.15, scrollTrigger: st });
      gsap.from(name,  { x: 30,  autoAlpha: 0, duration: 0.7, ease: "power2.out", delay: 0.3,  scrollTrigger: st });
    });

    /* ─── CARDS: CLIP REVEAL + IMAGE PARALLAX ─── */
    document.querySelectorAll(".card").forEach((card) => {
      gsap.from(card, {
        clipPath: "inset(100% 0 0 0)",
        duration: 1.1, ease: "power4.out",
        scrollTrigger: { trigger: card, start: "top 90%" },
        onComplete: () => gsap.set(card, { clearProps: "clipPath" }),
      });

      const media = card.querySelector("img, video");
      if (media) {
        gsap.fromTo(media, { y: "-8%" }, {
          y: "8%", ease: "none",
          scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: true },
        });
      }
    });

    /* ─── MISSION + CTA ─── */
    gsap.from(".mission-top-line", {
      scaleX: 0, transformOrigin: "left", duration: 1.2, ease: "power3.out",
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".mission-title", {
      autoAlpha: 0, duration: 1, ease: "power2.out", delay: 0.2,
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".mission-body", {
      y: 35, autoAlpha: 0, duration: 1.1, ease: "power2.out", delay: 0.4,
      scrollTrigger: { trigger: ".mission", start: "top 85%" },
    });
    gsap.from(".cta-divider", {
      scaleX: 0, transformOrigin: "left", duration: 1, ease: "power3.out",
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });
    gsap.from(".cta-label", {
      y: 20, autoAlpha: 0, duration: 0.8, delay: 0.2,
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });
    gsap.from(".cta-btn", {
      y: 20, autoAlpha: 0, duration: 0.7, delay: 0.4,
      scrollTrigger: { trigger: ".cta-block", start: "top 88%" },
    });

    /* ─── BACK LINK EXIT ─── */
    const backLink = document.querySelector(".back-link") as HTMLAnchorElement | null;
    if (backLink) {
      backLink.addEventListener("click", (e) => {
        e.preventDefault();
        const href = backLink.getAttribute("href") || "/";
        const curtain = document.createElement("div");
        curtain.style.cssText = "position:fixed;inset:0;background:#f6aad9;z-index:9999;transform-origin:bottom;will-change:transform;";
        gsap.set(curtain, { scaleY: 0 });
        document.body.appendChild(curtain);
        gsap.to(".word, .hero-sub", { y: -40, autoAlpha: 0, duration: 0.3, stagger: 0.06, ease: "power2.in" });
        gsap.to(curtain, {
          scaleY: 1, duration: 0.65, ease: "power3.inOut",
          onComplete: () => { window.location.href = href; },
        });
      });
    }
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    entryCurtain.remove();
    document.querySelectorAll(".card").forEach(c => {
      (c as HTMLElement).style.clipPath = "none";
    });
  });

  /* ── MOBILE LIGHTBOX ── */
  (function () {

    const overlay   = document.getElementById("lb-overlay")!;
    const lbImg     = document.getElementById("lb-img") as HTMLImageElement;
    const lbCat     = document.getElementById("lb-cat")!;
    const lbCounter = document.getElementById("lb-counter")!;
    const btnClose  = document.getElementById("lb-close")!;
    const btnPrev   = document.getElementById("lb-prev")!;
    const btnNext   = document.getElementById("lb-next")!;
    const lbSlay = document.getElementById("lb-slay") as HTMLButtonElement;

    // Build groups per category
    type Group = { name: string; imgs: HTMLImageElement[]; cards: HTMLElement[] };
    const groups: Group[] = [];
    const imgToGroup = new Map<HTMLImageElement, { group: Group; idx: number }>();

    document.querySelectorAll<HTMLElement>(".group-label").forEach((label) => {
      const name = label.querySelector(".group-name")?.textContent?.trim() || "";
      const imgs: HTMLImageElement[] = [];
      const cards: HTMLElement[] = [];
      let el = label.nextElementSibling;
      while (el && !el.classList.contains("group-label")) {
        el.querySelectorAll<HTMLImageElement>(".card img").forEach(img => {
          if (img.closest(".card-add")) return;
          const card = img.closest<HTMLElement>(".card");
          if (card) { imgs.push(img); cards.push(card); }
        });
        el = el.nextElementSibling;
      }
      const group: Group = { name, imgs, cards };
      groups.push(group);
      imgs.forEach((img, idx) => imgToGroup.set(img, { group, idx }));
    });

    let currentGroup: Group = groups[0];
    let currentIdx = 0;

    function updateUI() {
      lbImg.src = currentGroup.imgs[currentIdx].src;
      lbCat.textContent = currentGroup.name;
      lbCounter.textContent = `${currentIdx + 1} / ${currentGroup.imgs.length}`;
      const card = currentGroup.cards[currentIdx];
      lbSlay.classList.toggle("lb-slay-added", !!((window as any).__grlIsAdded?.(card)));
    }

    function open(img: HTMLImageElement) {
      const info = imgToGroup.get(img);
      if (!info) return;
      currentGroup = info.group;
      currentIdx = info.idx;
      updateUI();
      gsap.set(overlay, { display: "flex" });
      gsap.fromTo(overlay, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3, ease: "power2.out" });
      document.body.style.overflow = "hidden";
      // pop-in + wobble loop
      gsap.killTweensOf(lbSlay);
      gsap.fromTo(lbSlay,
        { scale: 0, rotation: 20, autoAlpha: 0 },
        { scale: 1, rotation: 8, autoAlpha: 1, duration: 0.5, delay: 0.25, ease: "back.out(3)",
          onComplete: () => gsap.to(lbSlay, { rotation: 12, duration: 1.4, repeat: -1, yoyo: true, ease: "sine.inOut" })
        }
      );
    }

    function close() {
      gsap.killTweensOf(lbSlay);
      gsap.to(overlay, { autoAlpha: 0, duration: 0.25, onComplete: () => gsap.set(overlay, { display: "none" }) });
      document.body.style.overflow = "";
    }

    function navigate(delta: number) {
      const dir = delta > 0 ? 40 : -40;
      currentIdx = (currentIdx + delta + currentGroup.imgs.length) % currentGroup.imgs.length;
      gsap.fromTo(lbImg, { autoAlpha: 0, x: dir }, { autoAlpha: 1, x: 0, duration: 0.25, ease: "power2.out" });
      updateUI();
    }

    // Wire up cards
    imgToGroup.forEach((_info, img) => {
      const card = img.closest("a");
      if (!card) return;
      card.addEventListener("click", (e) => { e.preventDefault(); open(img); });
    });

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => navigate(-1));
    btnNext.addEventListener("click", () => navigate(1));

    lbSlay.addEventListener("click", (e) => {
      e.stopPropagation();
      const card = currentGroup.cards[currentIdx];
      if (card && (window as any).__grlToggle) {
        (window as any).__grlToggle(card);
        lbSlay.classList.toggle("lb-slay-added", !!((window as any).__grlIsAdded?.(card)));
        gsap.fromTo(lbSlay, { scale: 0.8 }, { scale: 1, duration: 0.4, ease: "back.out(3)" });
      }
    });


    let startX = 0;
    overlay.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) navigate(dx < 0 ? 1 : -1);
    });
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
  })();
</script>

