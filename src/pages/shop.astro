---
import Layout from "../layouts/Layout.astro";
import GradualBlur from "../components/GradualBlur.jsx";
---

<Layout
  title="Shop — GRL WORLD | Bikinis, Gym Sets & Stripe Sets"
  description="Shop GRL WORLD creative swimwear — bikinis, gym sets and stripe sets. Summer outfits for the beach. DM @gr1world to order."
  image="/img/shop/p5.jpg"
  url="https://grlworld.com/shop"
/>

<div id="entry-curtain"></div>

<div class="stk-layer" aria-hidden="true"></div>
<img id="gummy-btn" src="/img/collage/gummy-bear.png" />
<a id="slay-btn" href="https://www.instagram.com/gr1world" target="_blank" rel="noopener" aria-label="Order now">
  <img src="/img/collage/slay.png" alt="SLAY — Order Now" />
  <span id="slay-badge">0</span>
</a>

<!-- ORDER PANEL -->
<div id="order-panel">
  <div id="order-header">
    <h3>YOUR ORDER</h3>
    <button id="order-close" aria-label="Close">✕</button>
  </div>
  <p id="order-hint">Click <strong>+</strong> on any look to add it</p>
  <div id="order-items"></div>
