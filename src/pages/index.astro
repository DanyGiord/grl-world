---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Stripe from "../components/Stripe.astro";
import New from "../components/New.astro";
---

<Layout
  title="GRL WORLD — Creative Swimwear & Beach Outfits"
  description="GRL WORLD — Creative swimwear, beach outfits and summer style. Bikinis, gym sets and stripe sets. DM to order."
  image="/img/shop/p5.jpg"
/>
<main class="flex flex-col justify-center items-center text-center h-full">
  <h1 class="sm:text-9xl text-7xl pt-32 py-5">GRL</h1>
  <h1 class="sm:text-9xl text-7xl">WORLD</h1>
  <p class="tagline">Creative Swimwear &nbsp;·&nbsp; Beach Outfits &nbsp;·&nbsp; Summer Style</p>
  <div class="cloud-layer">
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="88"  data-y="8"   data-scale="1.0" data-op="0.72" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="62"  data-y="35"  data-scale="0.65" data-op="0.50" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="105" data-y="78"  data-scale="1.2"  data-op="0.80" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="74"  data-y="52"  data-scale="0.80" data-op="0.60" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="50"  data-y="20"  data-scale="0.55" data-op="0.42" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="95"  data-y="65"  data-scale="1.1"  data-op="0.68" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="68"  data-y="42"  data-scale="0.70" data-op="0.55" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="115" data-y="88"  data-scale="1.35" data-op="0.85" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="80"  data-y="15"  data-scale="0.90" data-op="0.65" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="57"  data-y="58"  data-scale="0.60" data-op="0.45" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="100" data-y="30"  data-scale="1.15" data-op="0.75" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="72"  data-y="70"  data-scale="0.75" data-op="0.58" />
    <img src="./img/cloud.svg" alt="" class="cl" data-speed="120" data-y="92"  data-scale="1.4"  data-op="0.88" />
  </div>
  <Card title="SHOP" href="/shop" />
</main>
<script>
  import { gsap } from "gsap";

  const mm = gsap.matchMedia();

  mm.add(
    {
      motion: "(prefers-reduced-motion: no-preference)",
      reduceMotion: "(prefers-reduced-motion: reduce)",
    },
    (context) => {
      const { reduceMotion } = context.conditions;

      // H1 entrance
      gsap.from("h1", {
        y: reduceMotion ? 0 : 60,
        autoAlpha: 0,
        duration: reduceMotion ? 0.01 : 1.2,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      // Tagline entrance
      gsap.from(".tagline", {
        y: reduceMotion ? 0 : 20,
        autoAlpha: 0,
        duration: reduceMotion ? 0.01 : 1,
        ease: "power2.out",
        delay: 0.6,
      });

      // Card entrance
      gsap.from(".c-header_button", {
        y: reduceMotion ? 0 : 40,
        autoAlpha: 0,
        duration: reduceMotion ? 0.01 : 1,
        delay: 0.8,
        ease: "power2.out",
      });

      // Clouds — always run regardless of reduce-motion
      {
        const W = window.innerWidth;
        const clouds = document.querySelectorAll<HTMLElement>(".cl");
        const n = clouds.length;
        const yDrifts = [14,-11,18,-9,12,-16,10,-13,15,-8,20,-12,16];
        clouds.forEach((el, i) => {
          const speed   = parseFloat(el.dataset.speed  || "80");
          const yPct    = parseFloat(el.dataset.y      || "50");
          const scale   = parseFloat(el.dataset.scale  || "1");
          const opacity = parseFloat(el.dataset.op     || "0.7");
          const cloudW  = 320 * scale;
          gsap.set(el, { top: `${yPct}%`, scale, opacity, x: -cloudW });
          gsap.to(el, { x: W + cloudW, duration: speed, repeat: -1, ease: "none", delay: -(speed * i / n) });
          gsap.to(el, { y: yDrifts[i % yDrifts.length], duration: speed / 9, repeat: -1, yoyo: true, ease: "sine.inOut" });
        });
      }

      if (!reduceMotion) {
        // Image float
        gsap.to(".img-1", {
          y: -8,
          duration: 2.8,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });
        gsap.to(".img-2", {
          y: -8,
          duration: 3.2,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
          delay: 0.6,
        });

        // Arrow bob
        gsap.to(".c-header_button_arrow", {
          y: 8,
          duration: 1.2,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });

        // Button hover + click transition
        const btn = document.querySelector(".c-button") as HTMLAnchorElement | null;
        if (btn) {
          btn.addEventListener("mouseenter", () => {
            gsap.to(btn, { scale: 1.05, duration: 0.2, ease: "power1.out" });
          });
          btn.addEventListener("mouseleave", () => {
            gsap.to(btn, { scale: 1, duration: 0.2, ease: "power1.in" });
          });
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            const href = btn.getAttribute("href") || "/shop";

            const curtain = document.createElement("div");
            curtain.style.cssText =
              "position:fixed;inset:0;background:#f6aad9;z-index:9999;transform-origin:bottom;will-change:transform;";
            gsap.set(curtain, { scaleY: 0 });
            document.body.appendChild(curtain);

            gsap.to("h1", { y: -40, autoAlpha: 0, duration: 0.35, stagger: 0.08, ease: "power2.in" });
            gsap.to(".c-header_button", { y: -20, autoAlpha: 0, duration: 0.25, ease: "power2.in" });
            gsap.to(curtain, {
              scaleY: 1,
              duration: 0.65,
              ease: "power3.inOut",
              onComplete: () => { window.location.href = href; },
            });
          });
        }
      }
    }
  );
</script>
<style is:global>
  html, body { overflow: hidden; height: 100%; }
</style>
<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
    padding-bottom: 320px;
    position: relative;
    z-index: 1;
  }
  h1 {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #466441;
  }
  .tagline {
    font-family: "TAN-NIMBUS", sans-serif;
    font-size: clamp(0.55rem, 1vw, 0.75rem);
    color: #466441;
    margin: 1.2rem 0 0;
  }
  .cloud-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .cl {
    position: absolute;
    left: 0;
    width: 320px;
    will-change: transform;
  }
  @media (max-width: 767px) {
    .cl { width: 180px; }
  }
</style>
