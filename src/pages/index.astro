---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Stripe from "../components/Stripe.astro";
import New from "../components/New.astro";
---

<Layout title="GRL WORLD" />
<main class="flex flex-col justify-center items-center text-center h-full">
  <h1 class="sm:text-9xl text-7xl pt-32 py-5">GRL</h1>
  <h1 class="sm:text-9xl text-7xl">WORLD</h1>
  <div class="cloud-layer">
    <img src="./img/cloud.svg" alt="Cloud image" class="box" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box2" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box3" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box5" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box4" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box6" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box7" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box8" />
    <img src="./img/cloud.svg" alt="Cloud image" class="box9" />
  </div>
  <!-- <div class="leptir">
    <img src="./img/leptir.gif" alt="Cloud image" class="w-16" />
  </div> -->
  <!-- </div> -->
  <Card title="SHOP" href="/shop" />
</main>
<!-- <Stripe /> -->
<!-- <New /> -->
<script>
  import { gsap } from "gsap";

  const mm = gsap.matchMedia();

  mm.add(
    {
      motion: "(prefers-reduced-motion: no-preference)",
      reduceMotion: "(prefers-reduced-motion: reduce)",
    },
    (context) => {
      const { reduceMotion } = context.conditions;

      // H1 entrance
      gsap.from("h1", {
        y: reduceMotion ? 0 : 60,
        autoAlpha: 0,
        duration: reduceMotion ? 0.01 : 1.2,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      // Card entrance
      gsap.from(".c-header_button", {
        y: reduceMotion ? 0 : 40,
        autoAlpha: 0,
        duration: reduceMotion ? 0.01 : 1,
        delay: 0.8,
        ease: "power2.out",
      });

      if (!reduceMotion) {
        // Clouds — varied speeds, vertical drift, staggered delays
        const cloudSelectors = [".box", ".box2", ".box3", ".box4", ".box5", ".box6", ".box7", ".box8", ".box9"];
        const durations =  [75, 55, 90, 65, 80, 50, 70, 60, 85];
        const yDrifts =    [15, -10, 20, -15, 10, -20, 12, -8, 18];
        const startDelays = [0,   5,  12,   3, 18,   8, 25,  2, 14];

        cloudSelectors.forEach((sel, i) => {
          gsap.to(sel, {
            x: "500%",
            duration: durations[i],
            repeat: -1,
            yoyo: true,
            ease: "none",
            delay: startDelays[i],
          });
          gsap.to(sel, {
            y: yDrifts[i],
            duration: durations[i] / 7,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            delay: startDelays[i],
          });
        });

        // Image float
        gsap.to(".img-1", {
          y: -8,
          duration: 2.8,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });
        gsap.to(".img-2", {
          y: -8,
          duration: 3.2,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
          delay: 0.6,
        });

        // Arrow bob
        gsap.to(".c-header_button_arrow", {
          y: 8,
          duration: 1.2,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
        });

        // Button hover + click transition
        const btn = document.querySelector(".c-button") as HTMLAnchorElement | null;
        if (btn) {
          btn.addEventListener("mouseenter", () => {
            gsap.to(btn, { scale: 1.05, duration: 0.2, ease: "power1.out" });
          });
          btn.addEventListener("mouseleave", () => {
            gsap.to(btn, { scale: 1, duration: 0.2, ease: "power1.in" });
          });
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            const href = btn.getAttribute("href") || "/shop";

            const curtain = document.createElement("div");
            curtain.style.cssText =
              "position:fixed;inset:0;background:#f6aad9;z-index:9999;transform-origin:bottom;will-change:transform;";
            gsap.set(curtain, { scaleY: 0 });
            document.body.appendChild(curtain);

            gsap.to("h1", { y: -40, autoAlpha: 0, duration: 0.35, stagger: 0.08, ease: "power2.in" });
            gsap.to(".c-header_button", { y: -20, autoAlpha: 0, duration: 0.25, ease: "power2.in" });
            gsap.to(curtain, {
              scaleY: 1,
              duration: 0.65,
              ease: "power3.inOut",
              onComplete: () => { window.location.href = href; },
            });
          });
        }
      }
    }
  );
</script>
<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
    padding-bottom: 320px;
  }
  h1 {
    font-family: "TAN-NIMBUS", sans-serif;
    color: #466441;
  }
  .cloud-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }
  /* responsive oblaci */
  @media (max-width: 767px) {
    .box,
    .box2,
    .box3,
    .box4,
    .box5,
    .box6,
    .box7,
    .box8,
    .box9 {
      width: 200px;
    }
  }
  .box {
    position: absolute;
    left: -20%;
    z-index: -1;
    top: 10%;
    overflow: hidden;
  }
  .box2 {
    position: absolute;
    left: 10%;
    top: 40%;
    overflow: hidden;
  }
  .box3 {
    position: absolute;
    left: -80%;
    top: 80%;
    overflow: hidden;
  }
  .box4 {
    position: absolute;
    left: -125%;
    top: 40%;
    overflow: hidden;
  }
  .box5 {
    position: absolute;
    left: -10%;
    top: 60%;
    overflow: hidden;
  }
  .box6 {
    position: absolute;
    left: -120%;
    top: 5%;
    overflow: hidden;
  }
  .box7 {
    position: absolute;
    left: 50%;
    top: 5%;
    overflow: hidden;
  }
  .box8 {
    position: absolute;
    left: 80%;
    top: 70%;
    overflow: hidden;
  }
  .box9 {
    position: absolute;
    left: -70%;
    top: 25%;
    overflow: hidden;
  }
</style>
